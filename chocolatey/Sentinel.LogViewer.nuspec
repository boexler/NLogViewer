<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>Sentinel.LogViewer</id>
    <version>0.0.0</version>
    <title>Sentinel.LogViewer</title>
    <authors>Dominic Böxler</authors>
    <projectUrl>https://github.com/boexler/NLogViewer</projectUrl>
    <projectSourceUrl>https://github.com/boexler/NLogViewer</projectSourceUrl>
    <packageSourceUrl>https://github.com/boexler/NLogViewer/tree/master/chocolatey</packageSourceUrl>
    <bugTrackerUrl>https://github.com/boexler/NLogViewer/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/boexler/NLogViewer/blob/master/LICENSE.md</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>nlog log viewer desktop windows</tags>
    <summary>View and analyze NLog and log files on Windows.</summary>
    <description>
Sentinel.LogViewer is a Windows desktop application for viewing and analyzing NLog and log files.

The package embeds the official x64 MSI. Stable and prerelease versions share the same package ID;
use Chocolatey's `--pre` option to install or upgrade to a development version.
    </description>
    <releaseNotes>https://github.com/boexler/NLogViewer/releases</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
