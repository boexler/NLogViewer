<Window x:Class="Sentinel.LogViewer.TestApp.Generator.GeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log generator" Width="860" Height="520" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,10,0,3"/>
            <Setter Property="Foreground" Value="#6B6B6B"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="12">
            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,3" Text="Interval (ms)"/>
            <TextBox x:Name="IntervalBox" Text="1000"/>
            <TextBlock Style="{StaticResource Label}" Text="Logs with an exception (%)"/>
            <TextBox x:Name="ExceptionBox" Text="20"/>
            <TextBlock Style="{StaticResource Label}" Text="Application names (separated by commas)"/>
            <TextBox x:Name="ApplicationBox" Text="TestApp" ToolTip="Plain XML sends a random one of them. NLog sends the first one. log4net sends the name of the process."/>
            <Button x:Name="StartStopButton" Margin="0,16,0,0" Content="Start" Click="OnStartStop"/>
            <Button Content="Send a message…" Click="OnSendMessage"/>
            <Button x:Name="EdgeButton" Content="Edge cases ▾" Click="OnEdgeCases">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="One event in pieces (TCP)" Click="OnEdgeInPieces"/>
                        <MenuItem Header="Broken XML" Click="OnEdgeBroken"/>
                        <MenuItem Header="Very large event" Click="OnEdgeLarge"/>
                        <MenuItem Header="Special characters and emoji" Click="OnEdgeSpecial"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="Back to start" Click="OnBackToStart"/>
            <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#6B6B6B"/>
        </StackPanel>

        <DockPanel Grid.Column="1" Margin="0,12,12,12">
            <TextBlock x:Name="CountsText" DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="14" Text="Sent: 0   With exception: 0   Failed: 0"/>
            <ListBox x:Name="LinesList" FontFamily="Consolas" FontSize="12"/>
        </DockPanel>
    </Grid>
</Window>
