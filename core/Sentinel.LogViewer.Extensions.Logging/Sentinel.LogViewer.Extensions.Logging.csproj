<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sentinel.LogViewer.Extensions.Logging</RootNamespace>
    <PackageId>Sentinel.LogViewer.Extensions.Logging</PackageId>
    <Description>AddLogViewer() for Microsoft.Extensions.Logging: the logs of an application appear in Sentinel.LogViewer</Description>
    <PackageTags>sentinel logviewer logging microsoft-extensions-logging ilogger wpf</PackageTags>
    <!-- Packing runs as an explicit `dotnet pack` step. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentinel.LogViewer.Core\Sentinel.LogViewer.Core.csproj" />
  </ItemGroup>

</Project>
