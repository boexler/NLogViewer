<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Sentinel.LogViewer.Wpf"
    xmlns:core="clr-namespace:Sentinel.LogViewer.Core;assembly=Sentinel.LogViewer.Core"
    xmlns:listViewLayoutManager="clr-namespace:Sentinel.LogViewer.Wpf.Helper.ListViewLayoutManager"
    xmlns:xamlMultiValueConverter="clr-namespace:Sentinel.LogViewer.Wpf.XamlMultiValueConverter"
    xmlns:helper="clr-namespace:Sentinel.LogViewer.Wpf.Helper"
    xmlns:xamlConverter="clr-namespace:Sentinel.LogViewer.Wpf.XamlConverter"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Class="Sentinel.LogViewer.Wpf.Themes.GenericTheme">

    <xamlConverter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <xamlMultiValueConverter:ILogEntryResolverToStringConverter x:Key="ILogEntryResolverToStringConverter"/>
    <xamlMultiValueConverter:TimeStampOriginalConverter x:Key="TimeStampOriginalConverter"/>
    <xamlConverter:ContextMenuHeaderConverter x:Key="ContextMenuHeaderConverter"/>

    <xamlConverter:EqualityConverter x:Key="EqualityConverter"/>
    <xamlConverter:HasFlagConverter x:Key="HasFlagConverter"/>
    <xamlConverter:LevelIndexConverter x:Key="LevelIndexConverter"/>

    <!-- Format of the time stamp column; on the header and on the cells, the control is the Tag of the element -->
    <ContextMenu x:Key="TimeStampFormatMenu" x:Shared="False">
        <MenuItem Header="Timestamp format" IsEnabled="False"/>
        <MenuItem Header="System"
                  IsChecked="{Binding PlacementTarget.Tag.EffectiveTimeStampFormat, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static core:TimeStampFormat.System}}"
                  Command="{Binding PlacementTarget.Tag.SetTimeStampFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static core:TimeStampFormat.System}"/>
        <MenuItem Header="ISO  2025-12-18 15:11:48.385"
                  IsChecked="{Binding PlacementTarget.Tag.EffectiveTimeStampFormat, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static core:TimeStampFormat.Iso}}"
                  Command="{Binding PlacementTarget.Tag.SetTimeStampFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static core:TimeStampFormat.Iso}"/>
        <MenuItem Header="German  18.12.2025 15:11:48.385"
                  IsChecked="{Binding PlacementTarget.Tag.EffectiveTimeStampFormat, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static core:TimeStampFormat.German}}"
                  Command="{Binding PlacementTarget.Tag.SetTimeStampFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static core:TimeStampFormat.German}"/>
        <MenuItem Header="English  12/18/2025 03:11:48.385 PM"
                  IsChecked="{Binding PlacementTarget.Tag.EffectiveTimeStampFormat, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static core:TimeStampFormat.English}}"
                  Command="{Binding PlacementTarget.Tag.SetTimeStampFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static core:TimeStampFormat.English}"/>
        <Separator/>
        <MenuItem Header="Default view"
                  Command="{Binding PlacementTarget.Tag.ResetTimeStampFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <!-- The application gives the command; without one there is nothing to show -->
        <MenuItem Header="Time zone..."
                  Command="{Binding PlacementTarget.Tag.ChangeTimeZoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.Tag.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
            <MenuItem.Style>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PlacementTarget.Tag.ChangeTimeZoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </MenuItem.Style>
        </MenuItem>
    </ContextMenu>

    <Style TargetType="{x:Type local:LogViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LogViewer}">
                    <ControlTemplate.Resources>
                        <!-- The icon of a level button: hidden when the buttons show a letter only -->
                        <Style x:Key="LevelIcon" TargetType="Image">
                            <Setter Property="Width" Value="16"/>
                            <Setter Property="Height" Value="16"/>
                            <Setter Property="Stretch" Value="Uniform"/>
                            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LevelButtonDisplay, RelativeSource={RelativeSource AncestorType=local:LogViewer}}" Value="Text">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!-- The letter of a level button: shown when the buttons show a letter, alone or next to the icon -->
                        <Style x:Key="LevelLetter" TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LevelButtonDisplay, RelativeSource={RelativeSource AncestorType=local:LogViewer}}" Value="Text">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LevelButtonDisplay, RelativeSource={RelativeSource AncestorType=local:LogViewer}}" Value="SymbolAndText">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!-- A filter shown as a chip in the result row -->
                        <Style x:Key="Chip" TargetType="Border">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="8,2"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=local:LogViewer}, Path=TextSearchTermBackground}"/>
                            <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource AncestorType=local:LogViewer}, Path=TextSearchTermBorderBrush}"/>
                            <Setter Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=local:LogViewer}, Path=TextSearchTermForeground}"/>
                        </Style>
                        <Style x:Key="ChipClose" TargetType="Button">
                            <Setter Property="Content" Value="&#x2715;"/>
                            <Setter Property="Margin" Value="6,0,0,0"/>
                            <Setter Property="Padding" Value="3,0"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <!-- A text box with a symbol in front and a hint while it is empty -->
                        <Style x:Key="WatermarkBox" TargetType="helper:WatermarkTextBox">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="helper:WatermarkTextBox">
                                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{TemplateBinding Glyph}"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           IsHitTestVisible="False" Opacity="0.6"/>
                                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Hint" Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Visibility="Collapsed"
                                                           Text="{TemplateBinding Hint}"
                                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- The hint goes as soon as the box has the focus, not only when something is typed -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Text" Value=""/>
                                                    <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                                            </MultiTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>                        <Style x:Key="ToolSeparator" TargetType="Rectangle">
                            <Setter Property="Width" Value="1"/>
                            <Setter Property="Height" Value="20"/>
                            <Setter Property="Margin" Value="6,0,8,0"/>
                            <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                        </Style>
                    </ControlTemplate.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="1">
                            <!-- The tool row; wraps into a second line when the control is narrow -->
                            <WrapPanel Orientation="Horizontal" Margin="0,5,0,3">
                                <!-- Controls -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2" VerticalAlignment="Center"
                                            Visibility="{Binding ShowControlButtons, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ToggleButton MinWidth="28" Height="26" Padding="4,0" Margin="0,0,2,0" AutomationProperties.Name="Auto-Scroll"
                                                  ToolTip="Auto-Scroll: scroll to the newest entry when new entries arrive"
                                                  IsChecked="{Binding Path=AutoScroll, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <Image Source="../Images/Small/ScrollDown.png" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </ToggleButton>
                                    <ToggleButton MinWidth="28" Height="26" Padding="4,0" Margin="0,0,2,0" AutomationProperties.Name="Pause"
                                                  ToolTip="Pause: no new entries are added to the list while it is pressed"
                                                  IsChecked="{Binding Path=Pause, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <Image Source="../Images/Small/Pause.png" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </ToggleButton>
                                    <Button Width="28" Height="26" Padding="0" Margin="0,0,2,0" AutomationProperties.Name="Clear"
                                            ToolTip="Clear: remove all entries from the list"
                                            Command="{Binding Path=ClearCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Image Source="../Images/Small/Clear.png" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>
                                    <Rectangle Style="{StaticResource ToolSeparator}"/>
                                </StackPanel>

                                <!-- Levels: pressed hides the entries of the level -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2" VerticalAlignment="Center"
                                            Visibility="{Binding ShowFilterButtons, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ToggleButton MinWidth="28" Height="26" Padding="4,0" Margin="0,0,2,0" AutomationProperties.Name="Trace"
                                                  ToolTip="Hide the Trace entries (press again to show them)"
                                                  IsChecked="{Binding Path=TraceFilter, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="../Images/Large/Trace.png" Style="{StaticResource LevelIcon}"/>
                                            <TextBlock Text="T" Style="{StaticResource LevelLetter}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton MinWidth="28" Height="26" Padding="4,0" Margin="0,0,2,0" AutomationProperties.Name="Debug"
                                                  ToolTip="Hide the Debug entries (press again to show them)"
                                                  IsChecked="{Binding Path=DebugFilter, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="../Images/Large/Debug.png" Style="{StaticResource LevelIcon}"/>
                                            <TextBlock Text="D" Style="{StaticResource LevelLetter}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton MinWidth="28" Height="26" Padding="4,0" Margin="0,0,2,0" AutomationProperties.Name="Info"
                                                  ToolTip="Hide the Info entries (press again to show them)"
                                                  IsChecked="{Binding Path=InfoFilter, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="../Images/Large/Info.png" Style="{StaticResource LevelIcon}"/>
                                            <TextBlock Text="I" Style="{StaticResource LevelLetter}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton MinWidth="28" Height="26" Padding="4,0" Margin="0,0,2,0" AutomationProperties.Name="Warn"
                                                  ToolTip="Hide the Warn entries (press again to show them)"
                                                  IsChecked="{Binding Path=WarnFilter, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="../Images/Large/Warning.png" Style="{StaticResource LevelIcon}"/>
                                            <TextBlock Text="W" Style="{StaticResource LevelLetter}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton MinWidth="28" Height="26" Padding="4,0" Margin="0,0,2,0" AutomationProperties.Name="Error"
                                                  ToolTip="Hide the Error entries (press again to show them)"
                                                  IsChecked="{Binding Path=ErrorFilter, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="../Images/Large/Error.png" Style="{StaticResource LevelIcon}"/>
                                            <TextBlock Text="E" Style="{StaticResource LevelLetter}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton MinWidth="28" Height="26" Padding="4,0" Margin="0,0,2,0" AutomationProperties.Name="Fatal"
                                                  ToolTip="Hide the Fatal entries (press again to show them)"
                                                  IsChecked="{Binding Path=FatalFilter, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="../Images/Large/Fatal.png" Style="{StaticResource LevelIcon}"/>
                                            <TextBlock Text="F" Style="{StaticResource LevelLetter}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Rectangle Style="{StaticResource ToolSeparator}"/>
                                </StackPanel>

                                <!-- Filter: hides entries that do not match the terms -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2" VerticalAlignment="Center"
                                            Visibility="{Binding ShowSearchControls, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <helper:WatermarkTextBox Height="26" Padding="4,1" VerticalContentAlignment="Center" Width="220" Margin="0,0,6,0"
                                             AutomationProperties.Name="Filter" Glyph="&#xE71C;" Hint="Filter the entries"
                                             Text="{Binding CurrentSearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filter the entries by the chosen fields (Press Enter to add)">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddSearchTermCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </TextBox.InputBindings>
                                        <TextBox.Style>
                                            <Style TargetType="helper:WatermarkTextBox" BasedOn="{StaticResource WatermarkBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FilterError, RelativeSource={RelativeSource AncestorType=local:LogViewer}, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Null}}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource AncestorType=local:LogViewer}, Path=ErrorForeground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </helper:WatermarkTextBox>
                                    <ComboBox Width="70" Height="26" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                              SelectedValuePath="Tag" AutomationProperties.Name="Show or hide the entries that match"
                                              SelectedValue="{Binding FilterIsExclude, RelativeSource={RelativeSource TemplatedParent}}"
                                              ToolTip="Show the entries that match, or hide them">
                                        <ComboBoxItem Content="Show"><ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                                        <ComboBoxItem Content="Hide"><ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                                    </ComboBox>
                                    <ComboBox Width="90" Height="26" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                              AutomationProperties.Name="Level of the filter"
                                              SelectedIndex="{Binding FilterLevel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LevelIndexConverter}}"
                                              ToolTip="Only entries of this level">
                                        <ComboBoxItem Content="Any level"/>
                                        <ComboBoxItem Content="Trace"/>
                                        <ComboBoxItem Content="Debug"/>
                                        <ComboBoxItem Content="Info"/>
                                        <ComboBoxItem Content="Warn"/>
                                        <ComboBoxItem Content="Error"/>
                                        <ComboBoxItem Content="Fatal"/>
                                    </ComboBox>
                                    <helper:SearchOptions Margin="0,0,0,0"
                                                          MatchCase="{Binding FilterMatchCase, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                          WholeWord="{Binding FilterWholeWord, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                          UseRegex="{Binding UseRegexSearch, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                          PatternCommand="{Binding InsertRegexTemplateCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="-6,0,0,0" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <!-- The quick choices are counted back from the last entry; the dialog is for exact times -->
                                        <MenuItem Header="Time range ▾" ToolTip="Show only the entries of a period">
                                            <MenuItem Header="Last 15 minutes" Command="{Binding TimeRangeLastCommand}" CommandParameter="0:15:00"/>
                                            <MenuItem Header="Last hour" Command="{Binding TimeRangeLastCommand}" CommandParameter="1:00:00"/>
                                            <MenuItem Header="Last 24 hours" Command="{Binding TimeRangeLastCommand}" CommandParameter="24:00:00"/>
                                            <MenuItem Header="Last 7 days" Command="{Binding TimeRangeLastCommand}" CommandParameter="7.00:00:00"/>
                                            <Separator/>
                                            <MenuItem Header="Choose..." InputGestureText="Ctrl+Shift+T" Command="{Binding ChooseTimeRangeCommand}"/>
                                            <MenuItem Header="Clear the time range" Command="{Binding ClearTimeRangeCommand}"/>
                                        </MenuItem>
                                    </Menu>
                                    <TextBlock Text="{Binding FilterHitText, RelativeSource={RelativeSource TemplatedParent}}" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                                    <TextBlock Text="{Binding FilterError, RelativeSource={RelativeSource TemplatedParent}}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=local:LogViewer}, Path=ErrorForeground}" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FilterError, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </StackPanel>

                                <Button Width="28" Height="26" Padding="0" Margin="8,0,0,2" AutomationProperties.Name="Search" ToolTip="Search (Ctrl+F)"
                                        Visibility="{Binding ShowFindControls, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding OpenFindCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>

                                <!-- What a jump has to say, e.g. that there is no further entry of a level -->
                                <TextBlock Text="{Binding JumpText, RelativeSource={RelativeSource TemplatedParent}}" Margin="10,0,0,2" VerticalAlignment="Center" Opacity="0.8"/>
                            </WrapPanel>

                            <!-- The search bar (Ctrl+F): finds entries without hiding any -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsFindOpen, RelativeSource={RelativeSource AncestorType=local:LogViewer}}" Value="True"/>
                                                    <Condition Binding="{Binding ShowFindControls, RelativeSource={RelativeSource AncestorType=local:LogViewer}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <helper:WatermarkTextBox x:Name="PART_FindBox" Height="26" Padding="4,1" VerticalContentAlignment="Center" Width="220" Margin="0,0,6,2"
                                         AutomationProperties.Name="Search" Glyph="&#xE721;" Hint="Find in the entries"
                                         Text="{Binding FindText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Find in the chosen fields without hiding entries (Enter / Shift+Enter or F3 / Shift+F3: next / previous hit, Esc: close)">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding FindNextCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <KeyBinding Key="Return" Modifiers="Shift" Command="{Binding FindPreviousCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <KeyBinding Key="Escape" Command="{Binding CloseFindCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </TextBox.InputBindings>
                                    <TextBox.Style>
                                        <Style TargetType="helper:WatermarkTextBox" BasedOn="{StaticResource WatermarkBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FindError, RelativeSource={RelativeSource AncestorType=local:LogViewer}, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Null}}" Value="False">
                                                    <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource AncestorType=local:LogViewer}, Path=ErrorForeground}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </helper:WatermarkTextBox>
                                <ComboBox Width="90" Height="26" Padding="6,0" Margin="0,0,6,2" VerticalAlignment="Center"
                                          AutomationProperties.Name="Level of the search"
                                          SelectedIndex="{Binding FindLevel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LevelIndexConverter}}"
                                          ToolTip="Only entries of this level">
                                    <ComboBoxItem Content="Any level"/>
                                    <ComboBoxItem Content="Trace"/>
                                    <ComboBoxItem Content="Debug"/>
                                    <ComboBoxItem Content="Info"/>
                                    <ComboBoxItem Content="Warn"/>
                                    <ComboBoxItem Content="Error"/>
                                    <ComboBoxItem Content="Fatal"/>
                                </ComboBox>
                                <helper:SearchOptions Margin="0,0,0,2" Scope=" of the search"
                                                      MatchCase="{Binding FindMatchCase, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      WholeWord="{Binding FindWholeWord, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      UseRegex="{Binding FindUseRegex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      PatternCommand="{Binding InsertFindRegexTemplateCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Button Content="▲" Width="28" Height="26" Padding="0" Margin="6,0,2,2" AutomationProperties.Name="Previous hit"
                                        Command="{Binding FindPreviousCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTip="Previous hit (Shift+F3)"/>
                                <Button Content="▼" Width="28" Height="26" Padding="0" Margin="0,0,0,2" AutomationProperties.Name="Next hit"
                                        Command="{Binding FindNextCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTip="Next hit (F3)"/>
                                <TextBlock Text="{Binding FindResultText, RelativeSource={RelativeSource TemplatedParent}}" MinWidth="80" Margin="10,0,0,2" VerticalAlignment="Center"
                                           ToolTip="{Binding FindError, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Button Width="28" Height="26" Padding="0" Margin="6,0,0,2" Content="&#x2715;" AutomationProperties.Name="Close the search" ToolTip="Close the search (Esc)"
                                        Command="{Binding CloseFindCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </WrapPanel>

                            <!-- The result row: how many entries are shown, what filters them, and one click to take the filters off -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,5" MinHeight="32"
                                       Visibility="{Binding ShowSearchControls, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding FilterResultText, RelativeSource={RelativeSource TemplatedParent}}" Margin="2,0,10,0" VerticalAlignment="Center"/>
                                <!-- Active Filter Terms -->
                                <ItemsControl ItemsSource="{Binding ActiveSearchTerms, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Resources>
                                              <!-- Template for a filter term: plain text, regex or exclude, with its options -->
                                              <DataTemplate DataType="{x:Type core:FilterTerm}">
                                                  <Border BorderThickness="1" CornerRadius="10" Margin="2" Padding="8,2">
                                                      <Border.Style>
                                                          <Style TargetType="Border">
                                                              <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}, Path=TextSearchTermBackground}"/>
                                                              <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}, Path=TextSearchTermBorderBrush}"/>
                                                              <Setter Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}, Path=TextSearchTermForeground}"/>
                                                              <Style.Triggers>
                                                                  <DataTrigger Binding="{Binding IsRegex}" Value="True">
                                                                      <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}, Path=RegexSearchTermBackground}"/>
                                                                      <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}, Path=RegexSearchTermBorderBrush}"/>
                                                                      <Setter Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}, Path=RegexSearchTermForeground}"/>
                                                                  </DataTrigger>
                                                                  <DataTrigger Binding="{Binding IsExclude}" Value="True">
                                                                      <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}, Path=ErrorBackground}"/>
                                                                      <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}, Path=ErrorForeground}"/>
                                                                      <Setter Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}, Path=ErrorForeground}"/>
                                                                  </DataTrigger>
                                                              </Style.Triggers>
                                                          </Style>
                                                      </Border.Style>
                                                      <StackPanel Orientation="Horizontal">
                                                          <CheckBox Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Switch this term on or off" AutomationProperties.Name="{Binding Text, StringFormat='Apply the term {0}'}"
                                                                    IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                    Command="{Binding ToggleSearchTermCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}}"
                                                                    CommandParameter="{Binding}"/>
                                                          <TextBlock Text="−" FontWeight="Bold" Margin="0,0,4,0" ToolTip="Hides the entries that match">
                                                              <TextBlock.Style>
                                                                  <Style TargetType="TextBlock">
                                                                      <Setter Property="Visibility" Value="Collapsed"/>
                                                                      <Style.Triggers>
                                                                          <DataTrigger Binding="{Binding IsExclude}" Value="True">
                                                                              <Setter Property="Visibility" Value="Visible"/>
                                                                          </DataTrigger>
                                                                      </Style.Triggers>
                                                                  </Style>
                                                              </TextBlock.Style>
                                                          </TextBlock>
                                                          <TextBlock Text="Regex:" FontWeight="Bold" Margin="0,0,4,0"
                                                                     Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}, Path=RegexPrefixForeground}">
                                                              <TextBlock.Style>
                                                                  <Style TargetType="TextBlock">
                                                                      <Setter Property="Visibility" Value="Collapsed"/>
                                                                      <Style.Triggers>
                                                                          <DataTrigger Binding="{Binding IsRegex}" Value="True">
                                                                              <Setter Property="Visibility" Value="Visible"/>
                                                                          </DataTrigger>
                                                                      </Style.Triggers>
                                                                  </Style>
                                                              </TextBlock.Style>
                                                          </TextBlock>
                                                          <TextBlock Text="{Binding Text}" Margin="0,0,4,0">
                                                              <TextBlock.Style>
                                                                  <Style TargetType="TextBlock">
                                                                      <Style.Triggers>
                                                                          <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                              <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                              <Setter Property="Opacity" Value="0.75"/>
                                                                          </DataTrigger>
                                                                      </Style.Triggers>
                                                                  </Style>
                                                              </TextBlock.Style>
                                                          </TextBlock>
                                                          <TextBlock Text="Aa" FontSize="10" Margin="0,1,4,0" VerticalAlignment="Center" ToolTip="Match case">
                                                              <TextBlock.Style>
                                                                  <Style TargetType="TextBlock">
                                                                      <Setter Property="Visibility" Value="Collapsed"/>
                                                                      <Style.Triggers>
                                                                          <DataTrigger Binding="{Binding MatchCase}" Value="True">
                                                                              <Setter Property="Visibility" Value="Visible"/>
                                                                          </DataTrigger>
                                                                      </Style.Triggers>
                                                                  </Style>
                                                              </TextBlock.Style>
                                                          </TextBlock>
                                                          <TextBlock Text="W" FontSize="10" Margin="0,1,4,0" VerticalAlignment="Center" ToolTip="Whole word">
                                                              <TextBlock.Style>
                                                                  <Style TargetType="TextBlock">
                                                                      <Setter Property="Visibility" Value="Collapsed"/>
                                                                      <Style.Triggers>
                                                                          <DataTrigger Binding="{Binding WholeWord}" Value="True">
                                                                              <Setter Property="Visibility" Value="Visible"/>
                                                                          </DataTrigger>
                                                                      </Style.Triggers>
                                                                  </Style>
                                                              </TextBlock.Style>
                                                          </TextBlock>
                                                          <TextBlock Text="{Binding Level}" FontSize="10" Margin="0,1,4,0" VerticalAlignment="Center" ToolTip="Only entries of this level">
                                                              <TextBlock.Style>
                                                                  <Style TargetType="TextBlock">
                                                                      <Style.Triggers>
                                                                          <DataTrigger Binding="{Binding Level}" Value="{x:Null}">
                                                                              <Setter Property="Visibility" Value="Collapsed"/>
                                                                          </DataTrigger>
                                                                      </Style.Triggers>
                                                                  </Style>
                                                              </TextBlock.Style>
                                                          </TextBlock>
                                                          <Button Content="✏"
                                                                  Width="16"
                                                                  Height="16"
                                                                  FontSize="10"
                                                                  Padding="0"
                                                                  Margin="0,0,2,0"
                                                                  Command="{Binding EditSearchTermCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}}"
                                                                  CommandParameter="{Binding}"
                                                                  ToolTip="Edit filter term" AutomationProperties.Name="{Binding Text, StringFormat='Edit the term {0}'}"/>
                                                          <Button Content="×"
                                                                  Width="16"
                                                                  Height="16"
                                                                  FontSize="10"
                                                                  Padding="0"
                                                                  Margin="0"
                                                                  Command="{Binding RemoveSearchTermCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LogViewer}}"
                                                                  CommandParameter="{Binding}"
                                                                  ToolTip="Remove filter term" AutomationProperties.Name="{Binding Text, StringFormat='Remove the term {0}'}"/>
                                                      </StackPanel>
                                                  </Border>
                                              </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>

                                <!-- The time range, with one click to clear it -->
                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left"
                                        Visibility="{Binding HasTimeRange, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimeRangeText, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource ChipClose}" ToolTip="Show all the entries again" AutomationProperties.Name="Clear the time range"
                                                Command="{Binding ClearTimeRangeCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- The rules for loggers -->
                                <Border HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LoggerRuleCount, RelativeSource={RelativeSource AncestorType=local:LogViewer}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Loggers" VerticalAlignment="Center" ToolTip="Rules of the logger tree: loggers that are shown only, or hidden"/>
                                        <Button Style="{StaticResource ChipClose}" ToolTip="Show all loggers" AutomationProperties.Name="Show all loggers"
                                                Command="{Binding LoggerTree.ShowAllCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- The sort of the list, with one click to show the entries in the order they came in -->
                                <Border HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SortText, RelativeSource={RelativeSource AncestorType=local:LogViewer}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SortText, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource ChipClose}" ToolTip="Show the entries in the order they came in" AutomationProperties.Name="Reset column sorting"
                                                Command="{Binding ResetSortCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="Reset filter" Margin="6,0,0,0" Padding="8,1" Height="24" VerticalAlignment="Center"
                                        ToolTip="Take the levels, terms, loggers and the time range off"
                                        Visibility="{Binding HasActiveFilter, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding ResetFilterCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </WrapPanel>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition x:Name="PART_LoggerTreeLeftColumn" Width="0"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition x:Name="PART_LoggerTreeRightColumn" Width="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListView
                                x:Name="PART_ListView"
                                Grid.Column="3"
                                FontFamily="{Binding ListFontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                FontSize="{Binding ListFontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                ItemsSource="{Binding LogEvents.View, RelativeSource={RelativeSource TemplatedParent}, IsAsync=True}"
                                BorderThickness="0"
                                ScrollViewer.CanContentScroll="True"
                                listViewLayoutManager:ListViewLayoutManager.Enabled="true">
                            <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="BorderBrush" Value="Black" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.RowHeight)}"
                                                         Value="{x:Static local:RowHeightMode.Compact}">
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Padding" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Level}"
                                                         Value="{x:Static core:LogEntryLevel.Trace}">
                                                <Setter Property="Background"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).TraceBackground}" />
                                                <Setter Property="Foreground"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).TraceForeground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Level}"
                                                         Value="{x:Static core:LogEntryLevel.Debug}">
                                                <Setter Property="Foreground"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).DebugForeground}" />
                                                <Setter Property="Background"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).DebugBackground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Level}"
                                                         Value="{x:Static core:LogEntryLevel.Info}">
                                                <Setter Property="Foreground"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).InfoForeground}" />
                                                <Setter Property="Background"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).InfoBackground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Level}"
                                                         Value="{x:Static core:LogEntryLevel.Warn}">
                                                <Setter Property="Foreground"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).WarnForeground}" />
                                                <Setter Property="Background"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).WarnBackground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Level}"
                                                         Value="{x:Static core:LogEntryLevel.Error}">
                                                <Setter Property="Foreground"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).ErrorForeground}" />
                                                <Setter Property="Background"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).ErrorBackground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Level}"
                                                         Value="{x:Static core:LogEntryLevel.Fatal}">
                                                <Setter Property="Foreground"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).FatalForeground}" />
                                                <Setter Property="Background"
                                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).FatalBackground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <helper:AutoSizedGridView>
                                        <GridViewColumn Header="ID" Width="40">
                                            <GridViewColumn.DisplayMemberBinding>
                                                <MultiBinding Converter="{StaticResource ILogEntryResolverToStringConverter}">
                                                    <Binding Path="."/>
                                                    <Binding RelativeSource="{RelativeSource Self}" Path="(local:LogViewer.Owner).IdResolver"/>
                                                </MultiBinding>
                                            </GridViewColumn.DisplayMemberBinding>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Level" Width="Auto">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image x:Name="Image" RenderOptions.BitmapScalingMode="Linear"
                                                               Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="LevelText" Text="{Binding Path=Level}" Visibility="Collapsed"
                                                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                                                   Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, Path=Foreground}"/>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=Level}"
                                                                     Value="{x:Static core:LogEntryLevel.Trace}">
                                                            <Setter TargetName="Image" Property="Source"
                                                                    Value="../Images/Small/Trace.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=Level}"
                                                                     Value="{x:Static core:LogEntryLevel.Debug}">
                                                            <Setter TargetName="Image" Property="Source"
                                                                    Value="../Images/Small/Debug.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=Level}"
                                                                     Value="{x:Static core:LogEntryLevel.Info}">
                                                            <Setter TargetName="Image" Property="Source"
                                                                    Value="../Images/Small/Info.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=Level}"
                                                                     Value="{x:Static core:LogEntryLevel.Warn}">
                                                            <Setter TargetName="Image" Property="Source"
                                                                    Value="../Images/Small/Warning.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=Level}"
                                                                     Value="{x:Static core:LogEntryLevel.Error}">
                                                            <Setter TargetName="Image" Property="Source"
                                                                    Value="../Images/Small/Error.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=Level}"
                                                                     Value="{x:Static core:LogEntryLevel.Fatal}">
                                                            <Setter TargetName="Image" Property="Source"
                                                                    Value="../Images/Small/Fatal.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.LevelDisplay)}"
                                                                     Value="{x:Static local:LevelDisplayMode.Text}">
                                                            <Setter TargetName="Image" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="LevelText" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="LevelText" Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.LevelDisplay)}"
                                                                     Value="{x:Static local:LevelDisplayMode.SymbolAndText}">
                                                            <Setter TargetName="LevelText" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.RowHeight)}"
                                                                     Value="{x:Static local:RowHeightMode.Compact}">
                                                            <Setter TargetName="Image" Property="Height" Value="14" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="TimeStamp" Width="Auto">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Background="Transparent"
                                                        ContextMenu="{StaticResource TimeStampFormatMenu}"
                                                        Tag="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner)}"
                                                        Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, Path=Foreground}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource ILogEntryResolverToStringConverter}">
                                                                <Binding Path="."/>
                                                                <Binding RelativeSource="{RelativeSource Self}" Path="(local:LogViewer.Owner).TimeStampResolver"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                        <TextBlock.ToolTip>
                                                            <MultiBinding Converter="{StaticResource TimeStampOriginalConverter}">
                                                                <Binding Path="."/>
                                                                <Binding RelativeSource="{RelativeSource Self}" Path="(local:LogViewer.Owner).TimeStampResolver"/>
                                                            </MultiBinding>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="LoggerName" Width="Auto">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        helper:MessageHighlighter.Resolver="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).LoggerNameResolver}"
                                                        Background="Transparent"
                                                        Tag="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner)}"
                                                        Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, Path=Foreground}">
                                                        <TextBlock.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem
                                                                    Header="{Binding LoggerName, Converter={StaticResource ContextMenuHeaderConverter}}"
                                                                    IsEnabled="False"/>
                                                                <MenuItem
                                                                    Header="Show only this logger"
                                                                    Command="{Binding PlacementTarget.Tag.ShowOnlyLoggerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                    CommandParameter="{Binding LoggerName}"/>
                                                                <MenuItem
                                                                    Header="Hide this logger"
                                                                    Command="{Binding PlacementTarget.Tag.HideLoggerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                    CommandParameter="{Binding LoggerName}"/>
                                                                <MenuItem
                                                                    Header="Copy to Clipboard"
                                                                    Command="{Binding PlacementTarget.Tag.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.CommandParameter>
                                                                        <MultiBinding Converter="{StaticResource ILogEntryResolverToStringConverter}">
                                                                            <Binding Path="."/>
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=ContextMenu}" Path="PlacementTarget.Tag.LoggerNameResolver"/>
                                                                        </MultiBinding>
                                                                    </MenuItem.CommandParameter>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </TextBlock.ContextMenu>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Message" Width="Auto" listViewLayoutManager:RangeColumn.IsFillColumn="True">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        x:Name="TextBlock1"
                                                        helper:MessageHighlighter.Resolver="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner).MessageResolver}"
                                                        Background="Transparent"
                                                        Tag="{Binding RelativeSource={RelativeSource Self}, Path=(local:LogViewer.Owner)}"
                                                        Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, Path=Foreground}">
                                                        <TextBlock.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem
                                                                    Header="{Binding Message, Converter={StaticResource ContextMenuHeaderConverter}}"
                                                                    IsEnabled="False"/>
                                                                <MenuItem
                                                                    Header="Add to Filter"
                                                                    Command="{Binding PlacementTarget.Tag.AddRegexSearchTermCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.CommandParameter>
                                                                        <MultiBinding Converter="{StaticResource ILogEntryResolverToStringConverter}">
                                                                            <Binding Path="."/>
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=ContextMenu}" Path="PlacementTarget.Tag.MessageResolver"/>
                                                                        </MultiBinding>
                                                                    </MenuItem.CommandParameter>
                                                                </MenuItem>
                                                                <MenuItem
                                                                    Header="Copy to Clipboard"
                                                                    Command="{Binding PlacementTarget.Tag.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.CommandParameter>
                                                                        <MultiBinding Converter="{StaticResource ILogEntryResolverToStringConverter}">
                                                                            <Binding Path="."/>
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=ContextMenu}" Path="PlacementTarget.Tag.MessageResolver"/>
                                                                        </MultiBinding>
                                                                    </MenuItem.CommandParameter>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </TextBlock.ContextMenu>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </helper:AutoSizedGridView>
                                </ListView.View>
                            </ListView>

                            <!-- Logger tree: opens on the right of the list -->
                            <GridSplitter x:Name="PART_LoggerTreeSplitter" Grid.Column="4" Width="5" Visibility="Collapsed"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                          ToolTip="Drag to change the width of the logger tree">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Border Background="Transparent">
                                            <Rectangle Width="1" HorizontalAlignment="Center"
                                                       Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                        </Border>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>
                            <Border x:Name="PART_LoggerTreePanel" Grid.Column="5" Visibility="Collapsed">
                                <DockPanel Margin="6">
                                    <Grid DockPanel.Dock="Top" Margin="2,0,0,4">
                                        <TextBlock Text="Loggers" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ToggleButton HorizontalAlignment="Right" Width="24" Height="22" Padding="0"
                                                      ToolTip="Move the logger tree to the other side"
                                                      IsChecked="{Binding IsLoggerTreeOnLeft, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <TextBlock FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <!-- The arrow points to the side the tree moves to. It is set by the style, because a Text on the element would win over the trigger. -->
                                                        <Setter Property="Text" Value="&#x2190;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLoggerTreeOnLeft, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                <Setter Property="Text" Value="&#x2192;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </ToggleButton>
                                    </Grid>
                                    <helper:WatermarkTextBox DockPanel.Dock="Top" Height="26" Margin="0,0,0,6" Style="{StaticResource WatermarkBox}"
                                                             Glyph="&#xE721;" Hint="Search loggers" AutomationProperties.Name="Search loggers"
                                                             ToolTip="Show only the loggers whose name contains the text; the entries of the list do not change"
                                                             Text="{Binding LoggerTree.SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TreeView x:Name="PART_LoggerTreeView" ItemsSource="{Binding LoggerTree.Roots, RelativeSource={RelativeSource TemplatedParent}}"
                                              BorderThickness="0" Background="Transparent"
                                              VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                                        <TreeView.Resources>
                                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                                <Setter Property="Visibility" Value="{Binding IsListed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                            <HierarchicalDataTemplate DataType="{x:Type core:LoggerNode}" ItemsSource="{Binding Children}">
                                                <Grid Background="Transparent" Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Show only this logger"
                                                                      Command="{Binding PlacementTarget.DataContext.Tree.ShowOnlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="Show all loggers"
                                                                      Command="{Binding PlacementTarget.DataContext.Tree.ShowAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <Separator/>
                                                            <MenuItem Header="Expand all"
                                                                      Command="{Binding PlacementTarget.DataContext.Tree.ExpandAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="Collapse all"
                                                                      Command="{Binding PlacementTarget.DataContext.Tree.CollapseAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <CheckBox Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding FullName}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Grid.Column="2" Margin="4,0,0,0" Padding="5,0" CornerRadius="7" ToolTip="Warnings"
                                                            Background="{Binding WarnBackground, RelativeSource={RelativeSource AncestorType=local:LogViewer}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding WarnCount}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding WarnCount}" FontSize="10"
                                                                   Foreground="{Binding WarnForeground, RelativeSource={RelativeSource AncestorType=local:LogViewer}}"/>
                                                    </Border>
                                                    <Border Grid.Column="3" Margin="4,0,0,0" Padding="5,0" CornerRadius="7" ToolTip="Errors and fatal errors"
                                                            Background="{Binding ErrorBackground, RelativeSource={RelativeSource AncestorType=local:LogViewer}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ErrorCount}" FontSize="10"
                                                                   Foreground="{Binding ErrorForeground, RelativeSource={RelativeSource AncestorType=local:LogViewer}}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="4" Margin="6,0,0,0" Text="{Binding TotalCount}" ToolTip="Entries"
                                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </HierarchicalDataTemplate>
                                        </TreeView.Resources>
                                    </TreeView>
                                </DockPanel>
                            </Border>
                            <ToggleButton x:Name="PART_LoggerTreeHandle" Grid.Column="6" Width="22" Margin="2,0,0,0"
                                          ToolTip="Show or hide the logger tree"
                                          IsChecked="{Binding IsLoggerTreeExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <TextBlock Text="Loggers">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </ToggleButton>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLoggerTreeExpanded" Value="True">
                            <Setter TargetName="PART_LoggerTreePanel" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_LoggerTreeSplitter" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsLoggerTreeOnLeft" Value="True">
                            <Setter TargetName="PART_LoggerTreeHandle" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="PART_LoggerTreeHandle" Property="Margin" Value="0,0,2,0"/>
                            <Setter TargetName="PART_LoggerTreePanel" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="PART_LoggerTreeSplitter" Property="Grid.Column" Value="2"/>
                        </Trigger>
                        <Trigger Property="ShowLoggerTree" Value="False">
                            <Setter TargetName="PART_LoggerTreePanel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_LoggerTreeSplitter" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_LoggerTreeHandle" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>