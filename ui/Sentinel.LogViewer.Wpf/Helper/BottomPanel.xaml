<UserControl x:Class="Sentinel.LogViewer.Wpf.Helper.BottomPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sentinel.LogViewer.Wpf"
             xmlns:helper="clr-namespace:Sentinel.LogViewer.Wpf.Helper"
             xmlns:xamlMultiValueConverter="clr-namespace:Sentinel.LogViewer.Wpf.XamlMultiValueConverter">
    <!-- The panel below the list of a viewer, which is the data context: the tabs Results, Repeats and Details -->
    <UserControl.Resources>
        <xamlMultiValueConverter:EntryTextConverter x:Key="EntryText"/>
        <helper:EnumIndexConverter x:Key="TabIndex"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- The text of the level, centered in its column; the value is an entry or a group of repeats -->
        <DataTemplate x:Key="LevelCell">
            <TextBlock HorizontalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource EntryText}" ConverterParameter="Level">
                        <Binding Path="."/>
                        <Binding RelativeSource="{RelativeSource AncestorType=helper:BottomPanel}" Path="DataContext"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <!-- The cells of a row fill their column, so that the level can be centered -->
        <Style x:Key="FullCellRow" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- The buttons for a repeated message are off as long as no row is selected -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=RepeatRows}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A hint that shows only while a value is empty -->
        <Style x:Key="HintWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FindText}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HintWithoutEntry" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Details}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailsGrid" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TabControl x:Name="Tabs" SelectedIndex="{Binding BottomPanelTab, Converter={StaticResource TabIndex}, Mode=TwoWay}" Padding="6">
            <!-- Results: all hits of the search -->
            <TabItem Header="{local:Text Key=Panel_Results}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="{Binding FindResultText}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintWhenEmpty}" Text="{local:Text Key=Results_Empty}"/>
                    <ListView x:Name="HitRows" ItemContainerStyle="{StaticResource FullCellRow}" ItemsSource="{Binding FindHits}" SelectionMode="Single" MouseDoubleClick="OnHitDoubleClick"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{local:Text Key=Col_Id}" Width="50">
                                    <GridViewColumn.DisplayMemberBinding>
                                        <MultiBinding Converter="{StaticResource EntryText}" ConverterParameter="Id">
                                            <Binding Path="."/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=helper:BottomPanel}" Path="DataContext"/>
                                        </MultiBinding>
                                    </GridViewColumn.DisplayMemberBinding>
                                </GridViewColumn>
                                <GridViewColumn Header="{local:Text Key=Col_Level}" Width="70" CellTemplate="{StaticResource LevelCell}"/>
                                <GridViewColumn Header="{local:Text Key=Col_TimeStamp}" Width="160">
                                    <GridViewColumn.DisplayMemberBinding>
                                        <MultiBinding Converter="{StaticResource EntryText}" ConverterParameter="Time">
                                            <Binding Path="."/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=helper:BottomPanel}" Path="DataContext"/>
                                        </MultiBinding>
                                    </GridViewColumn.DisplayMemberBinding>
                                </GridViewColumn>
                                <GridViewColumn Header="{local:Text Key=Col_Logger}" Width="170" DisplayMemberBinding="{Binding LoggerName}"/>
                                <GridViewColumn Header="{local:Text Key=Col_Message}" Width="520">
                                    <GridViewColumn.DisplayMemberBinding>
                                        <MultiBinding Converter="{StaticResource EntryText}" ConverterParameter="Message">
                                            <Binding Path="."/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=helper:BottomPanel}" Path="DataContext"/>
                                        </MultiBinding>
                                    </GridViewColumn.DisplayMemberBinding>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- Repeats: the same message again and again -->
            <TabItem Header="{local:Text Key=Panel_Repeats}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="{Binding RepeatsText}"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource RowButton}" Content="{local:Text Key=Rep_GoFirst}"
                                Command="{Binding GoToFirstRepeatCommand}" CommandParameter="{Binding SelectedItem, ElementName=RepeatRows}"/>
                        <Button Style="{StaticResource RowButton}" Content="{local:Text Key=Rep_GoLast}"
                                Command="{Binding GoToLastRepeatCommand}" CommandParameter="{Binding SelectedItem, ElementName=RepeatRows}"/>
                    </StackPanel>
                    <ListView x:Name="RepeatRows" ItemContainerStyle="{StaticResource FullCellRow}" ItemsSource="{Binding RepeatGroups}" SelectedItem="{Binding SelectedRepeat, Mode=TwoWay}" SelectionMode="Single" MouseDoubleClick="OnRepeatDoubleClick"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{local:Text Key=Rep_Count}" Width="70" DisplayMemberBinding="{Binding Count}"/>
                                <GridViewColumn Header="{local:Text Key=Col_Level}" Width="70" CellTemplate="{StaticResource LevelCell}"/>
                                <GridViewColumn Header="{local:Text Key=Col_Logger}" Width="170" DisplayMemberBinding="{Binding Logger}"/>
                                <GridViewColumn Header="{local:Text Key=Col_Message}" Width="380" DisplayMemberBinding="{Binding Sample}"/>
                                <GridViewColumn Header="{local:Text Key=Rep_First}" Width="160">
                                    <GridViewColumn.DisplayMemberBinding>
                                        <MultiBinding Converter="{StaticResource EntryText}" ConverterParameter="Time">
                                            <Binding Path="First"/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=helper:BottomPanel}" Path="DataContext"/>
                                        </MultiBinding>
                                    </GridViewColumn.DisplayMemberBinding>
                                </GridViewColumn>
                                <GridViewColumn Header="{local:Text Key=Rep_Last}" Width="160">
                                    <GridViewColumn.DisplayMemberBinding>
                                        <MultiBinding Converter="{StaticResource EntryText}" ConverterParameter="Time">
                                            <Binding Path="Last"/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=helper:BottomPanel}" Path="DataContext"/>
                                        </MultiBinding>
                                    </GridViewColumn.DisplayMemberBinding>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- Details: the selected entry in full -->
            <TabItem Header="{local:Text Key=Panel_Details}">
                <Grid>
                    <TextBlock Style="{StaticResource HintWithoutEntry}" Text="{local:Text Key=Det_Empty}"/>
                    <Grid DataContext="{Binding Details}" Style="{StaticResource DetailsGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- What the entry is: time, level, logger, where it came from, where in the source it was written -->
                        <WrapPanel Grid.ColumnSpan="3" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Time}" Margin="0,0,12,0"/>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Level}" Margin="0,0,12,0"/>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Logger}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding Origin}" Margin="0,0,12,0" Visibility="{Binding HasOrigin, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source}" Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"
                                       ToolTip="{local:Text Key=Det_Source}"/>
                        </WrapPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Content="{local:Text Key=Det_CopyMessage}"
                                            Command="{Binding DataContext.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=helper:BottomPanel}}" CommandParameter="Message"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Content="{local:Text Key=Det_CopyEntry}"
                                            Command="{Binding DataContext.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=helper:BottomPanel}}" CommandParameter="Entry"/>
                                    <TextBlock Style="{StaticResource Label}" Text="{local:Text Key=Det_Message}"/>
                                </DockPanel>
                                <TextBox IsReadOnly="True" TextWrapping="Wrap" Text="{Binding Message, Mode=OneWay}"/>

                                <StackPanel Visibility="{Binding HasException, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                    <DockPanel Margin="0,0,0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Content="{local:Text Key=Det_CopyException}"
                                                Command="{Binding DataContext.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=helper:BottomPanel}}" CommandParameter="Exception"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{local:Text Key=Det_Exception}"/>
                                    </DockPanel>
                                    <TextBox IsReadOnly="True" FontFamily="Consolas, Courier New" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                             Text="{Binding Exception, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                        <!-- All properties of the entry -->
                        <DockPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="{local:Text Key=Det_Properties}" Margin="0,0,0,2"/>
                            <ListView ItemsSource="{Binding Properties}" SelectionMode="Single">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{local:Text Key=Det_Name}" Width="110" DisplayMemberBinding="{Binding Key}"/>
                                        <GridViewColumn Header="{local:Text Key=Det_Value}" Width="170" DisplayMemberBinding="{Binding Value}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Closes the panel; it sits over the empty end of the row of tabs -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" Padding="6,0" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                ToolTip="{local:Text Key=Panel_Close}" AutomationProperties.Name="{local:Text Key=Panel_Close}" Command="{Binding ToggleBottomPanelCommand}"/>
    </Grid>
</UserControl>
