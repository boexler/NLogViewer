<Window x:Class="Sentinel.LogViewer.SettingsWindow"
        Background="{DynamicResource ThemePageBackground}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Sentinel.LogViewer.Controls"
        xmlns:helpers="clr-namespace:Sentinel.LogViewer.Helpers"
        xmlns:settings="clr-namespace:Sentinel.LogViewer.ViewModels.Settings"
        xmlns:viewModels="clr-namespace:Sentinel.LogViewer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:SettingsViewModel}"
        Title="{helpers:Resource Key=Settings_Title, DefaultValue=Settings}"
        Width="900" Height="640" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Page header and section labels -->
            <DataTemplate DataType="{x:Type settings:SettingsPageHeader}">
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource ThemeTextSecondary}"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type settings:SettingsSectionLabel}">
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="2,10,0,6"
                           Foreground="{DynamicResource ThemeTextSecondary}"/>
            </DataTemplate>

            <!-- Settings that belong together: one card with a row for each setting -->
            <DataTemplate DataType="{x:Type settings:SettingsGroupViewModel}">
                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource ThemeIconFont}" FontSize="18"
                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Foreground="{DynamicResource ThemeTextSecondary}"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Settings}" Focusable="False">
                            <ItemsControl.Resources>
                                <!-- Inside the card a setting is a row: its title, and its control on the right; the description is the tooltip -->
                                <Style TargetType="controls:SettingCard">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="controls:SettingCard">
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="50,9,16,9"
                                                        Background="Transparent"
                                                        ToolTip="{Binding Setting.Description, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Setting.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                                                   FontSize="13" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                        <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- On / off -->
            <DataTemplate DataType="{x:Type settings:BoolSettingViewModel}">
                <controls:SettingCard Setting="{Binding}">
                    <ToggleButton Style="{StaticResource SettingsToggleSwitch}"
                                  IsChecked="{Binding Value}"
                                  AutomationProperties.Name="{Binding Title}"/>
                </controls:SettingCard>
            </DataTemplate>

            <!-- Fixed list of values -->
            <DataTemplate DataType="{x:Type settings:ChoiceSettingViewModel}">
                <controls:SettingCard Setting="{Binding}">
                    <ComboBox MinWidth="150" ItemsSource="{Binding Options}"
                              DisplayMemberPath="Display" SelectedValuePath="Value"
                              SelectedValue="{Binding Value}"
                              AutomationProperties.Name="{Binding Title}"/>
                </controls:SettingCard>
            </DataTemplate>

            <!-- How the log list looks: the settings on the left, a preview of a few rows that follows them on the right -->
            <DataTemplate DataType="{x:Type settings:ListLookSettingViewModel}">
                <controls:SettingCard Setting="{Binding}">
                    <Button Command="{Binding UndoCommand}" Padding="12,5"
                            ToolTip="{helpers:Resource Key=Settings_ListLookUndo_ToolTip, DefaultValue=Takes back the last change of this card and then the one before}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="{DynamicResource ThemeIconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="{helpers:Resource Key=Settings_ListLookUndo, DefaultValue=Undo}"/>
                        </StackPanel>
                    </Button>
                    <controls:SettingCard.Details>
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style x:Key="LookLabel" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                </Style>
                            </StackPanel.Resources>
                            <!-- The settings in two rows of four, the preview below them -->
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Style="{StaticResource LookLabel}" Text="{helpers:Resource Key=Settings_ThemeMode, DefaultValue=Colour mode}"/>
                                    <ComboBox ItemsSource="{Binding ColourModeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding ColourMode}"
                                              ToolTip="{helpers:Resource Key=Settings_ThemeMode_Description, DefaultValue=Light or dark or like Windows}"
                                              AutomationProperties.Name="{helpers:Resource Key=Settings_ThemeMode, DefaultValue=Colour mode}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Style="{StaticResource LookLabel}" Text="{helpers:Resource Key=Settings_Theme, DefaultValue=Theme}"/>
                                    <ComboBox ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Theme}"
                                              ToolTip="{helpers:Resource Key=Settings_Theme_Description, DefaultValue=The look of the application}"
                                              AutomationProperties.Name="{helpers:Resource Key=Settings_Theme, DefaultValue=Theme}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Style="{StaticResource LookLabel}" Text="{helpers:Resource Key=Settings_TimeStampFormat, DefaultValue=Timestamp format}"/>
                                    <ComboBox ItemsSource="{Binding TimeStampOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding TimeStampFormat}"
                                              ToolTip="{helpers:Resource Key=Settings_TimeStampFormat_Description, DefaultValue=Format of the timestamp column in the log list}"
                                              AutomationProperties.Name="{helpers:Resource Key=Settings_TimeStampFormat, DefaultValue=Timestamp format}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Style="{StaticResource LookLabel}" Text="{helpers:Resource Key=Settings_LevelDisplay, DefaultValue=Show level as}"/>
                                    <ComboBox ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Level}"
                                              ToolTip="{helpers:Resource Key=Settings_LevelDisplay_Description, DefaultValue=How the level of an entry is shown in the log list}"
                                              AutomationProperties.Name="{helpers:Resource Key=Settings_LevelDisplay, DefaultValue=Show level as}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Style="{StaticResource LookLabel}" Text="{helpers:Resource Key=Settings_RowHeight, DefaultValue=Row height}"/>
                                    <ComboBox ItemsSource="{Binding RowHeightOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding RowHeight}"
                                              ToolTip="{helpers:Resource Key=Settings_RowHeight_Description, DefaultValue=Compact rows show more entries on the screen.}"
                                              AutomationProperties.Name="{helpers:Resource Key=Settings_RowHeight, DefaultValue=Row height}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Style="{StaticResource LookLabel}" Text="{helpers:Resource Key=Settings_ListFontFamily, DefaultValue=Font of the log list}"/>
                                    <ComboBox ItemsSource="{Binding FontOptions}" SelectedValuePath="Value" SelectedValue="{Binding Family}"
                                              ToolTip="{helpers:Resource Key=Settings_ListFontFamily_Description, DefaultValue=The font of the entries and of the column headers in the log list}"
                                              AutomationProperties.Name="{helpers:Resource Key=Settings_ListFontFamily, DefaultValue=Font of the log list}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- A font is listed in its own typeface; the default entry has none -->
                                            <TextBlock Text="{Binding Display}"
                                                       FontFamily="{Binding FontFamily, TargetNullValue={x:Static SystemFonts.MessageFontFamily}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Style="{StaticResource LookLabel}" Text="{helpers:Resource Key=Settings_ListFontSize, DefaultValue=Font size of the log list}"/>
                                    <!-- Choose one of the sizes or type another one -->
                                    <ComboBox IsEditable="True" ItemsSource="{x:Static settings:ListLookSettingViewModel.SizeOptions}"
                                              Text="{Binding SizeText, UpdateSourceTrigger=LostFocus}"
                                              SelectedItem="{Binding SelectedSize}"
                                              ToolTip="{helpers:Resource Key=Settings_ListFontSize_Description, DefaultValue=The size of the text in the log list}"
                                              AutomationProperties.Name="{helpers:Resource Key=Settings_ListFontSize, DefaultValue=Font size of the log list}"/>
                                    <TextBlock Style="{StaticResource SettingsErrorText}" Text="{Binding Error}"/>
                                </StackPanel>
                            </UniformGrid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6"
                                        Grid.IsSharedSizeScope="True" ClipToBounds="True" HorizontalAlignment="Left">
                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False"
                                                  FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type settings:FontPreviewRow}">
                                                <Grid x:Name="Row">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PreviewId"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PreviewLevel"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PreviewTime"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PreviewLogger"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PreviewMessage"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Id}" Margin="{Binding Padding}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="{Binding Padding}">
                                                        <Image Source="{Binding Icon}" Height="{Binding IconHeight}" VerticalAlignment="Center"
                                                               Visibility="{Binding ShowSymbol, Converter={StaticResource ThemeBoolToVisibility}}"/>
                                                        <TextBlock Text="{Binding Level}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                   Visibility="{Binding ShowText, Converter={StaticResource ThemeBoolToVisibility}}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeStamp}" Margin="{Binding Padding}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Logger}" Margin="{Binding Padding}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Message}" Margin="{Binding Padding}"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Header">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeSurfaceAlt}"/>
                                                        <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Info">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource LogInfoBackground}"/>
                                                        <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource LogInfoForeground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Warn">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource LogWarnBackground}"/>
                                                        <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource LogWarnForeground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource LogErrorBackground}"/>
                                                        <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource LogErrorForeground}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </ScrollViewer>
                        </StackPanel>
                    </controls:SettingCard.Details>
                </controls:SettingCard>
            </DataTemplate>

            <!-- Number -->
            <DataTemplate DataType="{x:Type settings:IntSettingViewModel}">
                <controls:SettingCard Setting="{Binding}">
                    <StackPanel>
                        <TextBox Style="{StaticResource ThemeValidatedTextBox}" Width="110" HorizontalContentAlignment="Right"
                                 Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="{Binding Title}"/>
                        <TextBlock Style="{StaticResource SettingsErrorText}" MaxWidth="220" TextAlignment="Right"
                                   Text="{Binding Error}"/>
                    </StackPanel>
                </controls:SettingCard>
            </DataTemplate>

            <!-- Colour -->
            <DataTemplate DataType="{x:Type settings:ColorSettingViewModel}">
                <controls:SettingCard Setting="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ThemeIconButton}" Content="&#xE7A7;" Width="32" Height="30" Margin="0,0,8,0"
                                Command="{Binding ResetCommand}"
                                Visibility="{Binding IsCustom, Converter={StaticResource ThemeBoolToVisibility}}"
                                ToolTip="{helpers:Resource Key=Settings_Color_Reset, DefaultValue=Reset to the colour of the theme}"
                                AutomationProperties.Name="{helpers:Resource Key=Settings_Color_Reset, DefaultValue=Reset to the colour of the theme}"/>
                        <Border Width="30" Height="30" CornerRadius="6" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Top"
                                BorderBrush="{DynamicResource ThemeBorderStrong}" Background="{Binding Swatch}"/>
                        <StackPanel>
                            <TextBox Style="{StaticResource ThemeValidatedTextBox}" Width="110" FontFamily="Consolas"
                                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="{Binding Title}"/>
                            <TextBlock Style="{StaticResource SettingsErrorText}" MaxWidth="220" TextAlignment="Right"
                                       Text="{Binding Error}"/>
                        </StackPanel>
                    </StackPanel>
                </controls:SettingCard>
            </DataTemplate>

            <!-- List of ports -->
            <DataTemplate DataType="{x:Type settings:PortListSettingViewModel}">
                <controls:SettingCard Setting="{Binding}">
                    <Button  Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{DynamicResource ThemeIconFont}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="{helpers:Resource Key=Settings_AddPort, DefaultValue=Add port}"/>
                        </StackPanel>
                    </Button>
                    <controls:SettingCard.Details>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBox Style="{StaticResource ThemeValidatedTextBox}"
                                                         Text="{Binding Address, UpdateSourceTrigger=LostFocus}"/>
                                                <TextBlock Style="{StaticResource SettingsErrorText}" Text="{Binding Error}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource ThemeIconButton}"
                                                    Content="&#xE74D;" Width="32" Height="30" Margin="8,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="{helpers:Resource Key=Settings_RemovePort, DefaultValue=Remove port}"
                                                    AutomationProperties.Name="{helpers:Resource Key=Settings_RemovePort, DefaultValue=Remove port}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingCard.Details>
                </controls:SettingCard>
            </DataTemplate>

            <!-- List of ignored senders -->
            <DataTemplate DataType="{x:Type settings:IgnoreRuleListSettingViewModel}">
                <controls:SettingCard Setting="{Binding}">
                    <Button Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{DynamicResource ThemeIconFont}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="{helpers:Resource Key=Settings_AddIgnoreRule, DefaultValue=Add rule}"/>
                        </StackPanel>
                    </Button>
                    <controls:SettingCard.Details>
                        <StackPanel>
                            <Grid Margin="0,4,0,4" TextElement.Foreground="{DynamicResource ThemeTextMuted}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{helpers:Resource Key=Settings_IgnoreRuleIp, DefaultValue=IP address}"/>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{helpers:Resource Key=Settings_IgnoreRuleApplication, DefaultValue=Application}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Style="{StaticResource ThemeValidatedTextBox}"
                                                         Text="{Binding Ip, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="{helpers:Resource Key=Settings_IgnoreRuleIp, DefaultValue=IP address}"/>
                                                <TextBox Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ThemeValidatedTextBox}"
                                                         Text="{Binding Application, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="{helpers:Resource Key=Settings_IgnoreRuleApplication, DefaultValue=Application}"/>
                                                <Button Grid.Column="2" Style="{StaticResource ThemeIconButton}"
                                                        Content="&#xE74D;" Width="32" Height="30" HorizontalAlignment="Right"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="{helpers:Resource Key=Settings_RemoveIgnoreRule, DefaultValue=Remove rule}"
                                                        AutomationProperties.Name="{helpers:Resource Key=Settings_RemoveIgnoreRule, DefaultValue=Remove rule}"/>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SettingsErrorText}" Text="{Binding Error}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:SettingCard.Details>
                </controls:SettingCard>
            </DataTemplate>

            <!-- List of filter presets -->
            <DataTemplate DataType="{x:Type settings:PresetListSettingViewModel}">
                <controls:SettingCard Setting="{Binding}">
                    <controls:SettingCard.Details>
                        <StackPanel>
                            <TextBlock Text="{helpers:Resource Key=Settings_FilterPresets_Empty, DefaultValue=No presets yet.}"
                                       Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBox Style="{StaticResource ThemeValidatedTextBox}"
                                                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                                                    <TextBlock Style="{StaticResource SettingsErrorText}" Text="{Binding Error}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource ThemeIconButton}"
                                                        Content="&#xE74D;" Width="32" Height="30" Margin="8,0,0,0"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="{helpers:Resource Key=Settings_RemovePreset, DefaultValue=Remove preset}"
                                                        AutomationProperties.Name="{helpers:Resource Key=Settings_RemovePreset, DefaultValue=Remove preset}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:SettingCard.Details>
                </controls:SettingCard>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Background="{DynamicResource ThemeSurfaceAlt}" BorderBrush="{DynamicResource ThemeBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SettingsSearchBox}"
                         Margin="0,0,0,14" Height="32"
                         Tag="{helpers:Resource Key=Settings_SearchPlaceholder, DefaultValue=Search settings}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{helpers:Resource Key=Settings_SearchPlaceholder, DefaultValue=Search settings}"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Style="{StaticResource SettingsNavButton}" Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="{DynamicResource ThemeIconFont}" FontSize="14"
                                       Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="{helpers:Resource Key=Settings_Export, DefaultValue=Export…}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavButton}" Command="{Binding ImportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{DynamicResource ThemeIconFont}" FontSize="14"
                                       Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="{helpers:Resource Key=Settings_Import, DefaultValue=Import…}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                         ItemContainerStyle="{StaticResource SettingsNavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource ThemeIconFont}" FontSize="15"
                                           Width="26" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Settings -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="32,26,32,16">
                    <ItemsControl ItemsSource="{Binding PageItems}" Focusable="False"/>
                    <TextBlock Text="{Binding NoResultsText}" FontSize="13" Margin="2,8,0,0"
                               Foreground="{DynamicResource ThemeTextSecondary}"
                               Visibility="{Binding HasNoResults, Converter={StaticResource ThemeBoolToVisibility}}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="32,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource ThemeIconFont}" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextMuted}" Margin="0,1,8,0"/>
                        <TextBlock Text="{Binding FooterText}" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" 
                            Command="{Binding ResetCategoryCommand}" Content="{Binding ResetButtonText}"
                            Visibility="{Binding CanResetCategory, Converter={StaticResource ThemeBoolToVisibility}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
