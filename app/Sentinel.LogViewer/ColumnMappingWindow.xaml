<Window x:Class="Sentinel.LogViewer.ColumnMappingWindow"
        Background="{DynamicResource ThemePageBackground}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:Sentinel.LogViewer.Helpers"
        mc:Ignorable="d"
        Title="{helpers:Resource Key=ColumnMapping_Title, DefaultValue=Column Mapping Configuration}" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="{helpers:Resource Key=ColumnMapping_Heading, DefaultValue=Configure Column Mapping}" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Margin="0,0,0,15"
                   Grid.Row="0"/>

        <!-- Column Mapping Section -->
        <GroupBox Header="{helpers:Resource Key=ColumnMapping_GroupMapping, DefaultValue=Column Mapping}" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{helpers:Resource Key=ColumnMapping_Intro, DefaultValue=Map each detected column to a log field:}" 
                           Margin="0,0,0,10"
                           Grid.Row="0"/>

                <DataGrid x:Name="ColumnsDataGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Columns}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          MinHeight="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{helpers:Resource Key=ColumnMapping_ColumnHeader, DefaultValue=Column}" 
                                          Binding="{Binding Index}"
                                          IsReadOnly="True"
                                          Width="60" />
                        <DataGridTextColumn Header="{helpers:Resource Key=ColumnMapping_SampleHeader, DefaultValue=Sample Data}" 
                                          Binding="{Binding SampleData}"
                                          IsReadOnly="True"
                                          Width="*" />
                        <DataGridTemplateColumn Header="{helpers:Resource Key=ColumnMapping_MapToHeader, DefaultValue=Map To}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.FieldTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                            DisplayMemberPath="Display"
                                            SelectedValuePath="Value"
                                            SelectedValue="{Binding MappedField, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Options Section -->
        <GroupBox Header="{helpers:Resource Key=ColumnMapping_GroupOptions, DefaultValue=Options}" Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <Label Content="{helpers:Resource Key=ColumnMapping_Separator, DefaultValue=Separator:}" VerticalAlignment="Center" Padding="0,0,5,0" />
                    <ComboBox ItemsSource="{Binding Separators}"
                              DisplayMemberPath="Key"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Separator}"
                              MinWidth="180" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <Label Content="{helpers:Resource Key=ColumnMapping_DateOrder, DefaultValue=Date order:}" VerticalAlignment="Center" Padding="0,0,5,0" />
                    <ComboBox ItemsSource="{Binding DateOrders}"
                              DisplayMemberPath="Key"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding DateOrder}"
                              MinWidth="180"
                              ToolTip="{helpers:Resource Key=ColumnMapping_DateOrder_Tooltip, DefaultValue=How day and month are ordered in dates like 01/02/2025. Dates with a day above 12 tell it by themselves.}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <Label Content="{helpers:Resource Key=ColumnMapping_TimeZone, DefaultValue=Time zone of the file:}" VerticalAlignment="Center" Padding="0,0,5,0" />
                    <ComboBox ItemsSource="{Binding TimeZones}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding TimeZoneId}"
                              MinWidth="180" MaxWidth="360"
                              ToolTip="{helpers:Resource Key=ColumnMapping_TimeZone_Tooltip, DefaultValue=The zone in which the times without a zone were written. They are shown in your time. It can be changed later in the menu of the tab.}"/>
                </StackPanel>
                <CheckBox Content="{helpers:Resource Key=ColumnMapping_HasHeaderLine, DefaultValue=First line is a header/info line}"
                          IsChecked="{Binding HasHeaderLine}"
                          Margin="0,5"/>
                <CheckBox Content="{helpers:Resource Key=ColumnMapping_SaveForPattern, DefaultValue=Save this mapping for files matching pattern}" 
                          IsChecked="{Binding SaveForPattern}"
                          Margin="0,5"/>
                <Grid Margin="0,5,0,0" IsEnabled="{Binding SaveForPattern}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="{helpers:Resource Key=ColumnMapping_FilePattern, DefaultValue=File Pattern:}" Grid.Column="0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" 
                             Text="{Binding FilePattern, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5,0,0,0" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Preview Section -->
        <GroupBox Header="{helpers:Resource Key=ColumnMapping_GroupPreview, DefaultValue=Preview}" Grid.Row="3" Margin="0,0,0,10">
            <DataGrid ItemsSource="{Binding PreviewResults}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="None"
                      MinHeight="100">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding SampleData}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="{helpers:Resource Key=MessageBox_OK, DefaultValue=OK}" 
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Margin="0,0,5,0"
                    Padding="20,5"
                    MinWidth="80"/>
            <Button Content="{helpers:Resource Key=MessageBox_Cancel, DefaultValue=Cancel}" 
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Padding="20,5"
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>

