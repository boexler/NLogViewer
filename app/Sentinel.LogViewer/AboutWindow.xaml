<Window x:Class="Sentinel.LogViewer.AboutWindow"
        Background="{DynamicResource ThemePageBackground}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:Sentinel.LogViewer.Helpers"
        xmlns:viewModels="clr-namespace:Sentinel.LogViewer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:AboutViewModel}"
        Title="{helpers:Resource Key=About_Title, DefaultValue=About Sentinel LogViewer}"
        Width="700"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Card with a symbol on the left -->
        <Style x:Key="AboutCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="AboutCardSymbol" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource ThemeIconFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,1,14,0"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,26,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="128" Height="128" CornerRadius="64" VerticalAlignment="Top" HorizontalAlignment="Left"
                    Background="{DynamicResource ThemeSurfaceAlt}" BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1">
                <Image Source="pack://application:,,,/Sentinel.LogViewer;component/Resources/icons/icons8-analysieren-256.png"
                       Width="92" Height="92" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding ProductName}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,14"/>

                <!-- Update -->
                <Border Style="{StaticResource AboutCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE895;">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AboutCardSymbol}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpToDate}" Value="True">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeSuccess}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"/>
                            <ProgressBar Height="6" Margin="0,10,0,0" Maximum="100" Value="{Binding DownloadPercentage, Mode=OneWay}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource ThemeBoolToVisibility}}"/>
                            <TextBlock Margin="0,10,0,0">
                                <Hyperlink Command="{Binding ShowChangelogCommand}">
                                    <Run Text="{Binding ChangelogLinkText, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding DownloadCommand}"
                                    Content="{helpers:Resource Key=About_Download, DefaultValue=Download update}"
                                    Visibility="{Binding CanDownload, Converter={StaticResource ThemeBoolToVisibility}}"/>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding RestartCommand}"
                                    Content="{helpers:Resource Key=About_Restart, DefaultValue=Restart to update}"
                                    Visibility="{Binding CanRestart, Converter={StaticResource ThemeBoolToVisibility}}"/>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding CheckCommand}"
                                    Content="{helpers:Resource Key=About_Retry, DefaultValue=Try again}"
                                    Visibility="{Binding CanRetry, Converter={StaticResource ThemeBoolToVisibility}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="{Binding ShowChocolateyCommand, Converter={StaticResource ThemeBoolToVisibility}}">
                                <TextBox Text="{Binding ChocolateyCommand, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                         Padding="6,3" MinWidth="280"/>
                                <Button Command="{Binding CopyChocolateyCommand}" Margin="6,0,0,0" Padding="10,3"
                                        Content="{helpers:Resource Key=About_Copy, DefaultValue=Copy}"/>
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0"
                                       Visibility="{Binding ShowReleaseLink, Converter={StaticResource ThemeBoolToVisibility}}">
                                <Hyperlink NavigateUri="{Binding ReleasesUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                                    <Run Text="{helpers:Resource Key=About_OpenRelease, DefaultValue=Open the release page}"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Version -->
                <Border Style="{StaticResource AboutCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutCardSymbol}" Text="&#xE946;"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding VersionText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                       Text="{helpers:Resource Key=About_DevelopedBy, DefaultValue=Sentinel LogViewer is developed by Dominic Böxler and published as open source under the MIT License.}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="2,6,0,0">
                    <Hyperlink NavigateUri="{Binding ProjectUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{helpers:Resource Key=About_ProjectPage, DefaultValue=Project page}"/>
                    </Hyperlink>
                    <Run Text="    "/>
                    <Hyperlink NavigateUri="{Binding IssuesUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{helpers:Resource Key=About_ReportIssue, DefaultValue=Report an issue}"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceAlt}" BorderBrush="{DynamicResource ThemeBorder}"
                BorderThickness="0,1,0,0" Padding="28,12">
            <Grid>
                <TextBlock HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="{Binding LicenseUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{helpers:Resource Key=About_License, DefaultValue=License (MIT)}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center">
                    <Hyperlink NavigateUri="{Binding ReleasesUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{helpers:Resource Key=About_Releases, DefaultValue=All releases}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock HorizontalAlignment="Right" Text="© Dominic Böxler" Foreground="{DynamicResource ThemeTextMuted}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
