<Window x:Class="Sentinel.LogViewer.TextPromptWindow"
        Background="{DynamicResource ThemePageBackground}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Sentinel.LogViewer.Helpers"
        MinWidth="360"
        MaxWidth="520"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=InputBox}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,22,24,22">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10"/>
            <TextBox x:Name="InputBox"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceAlt}" BorderBrush="{DynamicResource ThemeBorder}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" MinWidth="80" Margin="8,0,0,0" IsDefault="True" Click="OnOkClick"
                        Content="{helpers:Resource Key=MessageBox_OK, DefaultValue=OK}"/>
                <Button MinWidth="80" Margin="8,0,0,0" IsCancel="True"
                        Content="{helpers:Resource Key=MessageBox_Cancel, DefaultValue=Cancel}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
