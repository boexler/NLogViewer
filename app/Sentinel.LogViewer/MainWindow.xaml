<Window x:Class="Sentinel.LogViewer.MainWindow"
        Background="{DynamicResource ThemePageBackground}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dj="clr-namespace:Sentinel.LogViewer.Wpf;assembly=Sentinel.LogViewer.Wpf"
        xmlns:viewModels="clr-namespace:Sentinel.LogViewer.ViewModels"
        xmlns:helpers="clr-namespace:Sentinel.LogViewer.Helpers"
        xmlns:models="clr-namespace:Sentinel.LogViewer.Models"
        xmlns:attachedProperties="clr-namespace:Sentinel.LogViewer.AttachedProperties"
        mc:Ignorable="d" 
        Title="Sentinel LogViewer" 
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}">
    <Grid>
        <Grid.Resources>
            <!-- Small close button in the tab header; only highlighted on hover -->
            <Style x:Key="TabCloseButtonStyle" TargetType="Button">
                <Setter Property="Content" Value="✕"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Margin" Value="6,0,-2,0"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Arrow in the tab header that opens the menu of the tab -->
            <Style x:Key="TabMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource TabCloseButtonStyle}">
                <Setter Property="Content" Value="▾"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
            <!-- Tab context menu; the TabItem's Tag holds the MainViewModel -->
            <ContextMenu x:Key="TabContextMenu" x:Shared="False">
                <MenuItem Header="{helpers:Resource Key=Tab_Close, DefaultValue=Close tab}"
                          Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="{helpers:Resource Key=Tab_CloseOthers, DefaultValue=Close all other tabs}"
                          Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="{helpers:Resource Key=Tab_CloseToTheRight, DefaultValue=Close tabs to the right}"
                          Command="{Binding PlacementTarget.Tag.CloseTabsToTheRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="{helpers:Resource Key=Tab_SaveFilteredList, DefaultValue=Save filtered list...}"
                          Command="{Binding PlacementTarget.Tag.SaveFilteredListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="{helpers:Resource Key=Tab_TakeOverFilters, DefaultValue=Take over the filters into new tabs of this application}"
                          IsChecked="{Binding TakesOverFilters, Mode=OneWay}"
                          Command="{Binding PlacementTarget.Tag.ToggleTakeOverFiltersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="{helpers:Resource Key=Tab_AfterRestart, DefaultValue=After a restart of this application}"
                          IsEnabled="{Binding IsLive}">
                    <MenuItem Header="{helpers:Resource Key=Restart_Extend, DefaultValue=Continue in the existing tab}"
                              Tag="ExtendTab" IsChecked="{Binding RestartExtendsTab, Mode=OneWay}" Click="RestartBehaviorMenuItem_Click"/>
                    <MenuItem Header="{helpers:Resource Key=Restart_NewTab, DefaultValue=Open a new tab}"
                              Tag="NewTab" IsChecked="{Binding RestartsInNewTab, Mode=OneWay}" Click="RestartBehaviorMenuItem_Click"/>
                    <MenuItem Header="{helpers:Resource Key=Restart_Replace, DefaultValue=Open a new tab and close the old one}"
                              Tag="ReplaceTab" IsChecked="{Binding RestartReplacesTab, Mode=OneWay}" Click="RestartBehaviorMenuItem_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{helpers:Resource Key=Tab_IgnoreApplicationFromSender, DefaultValue=Ignore this application (from this IP address)}"
                          Command="{Binding PlacementTarget.Tag.IgnoreApplicationFromSenderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="{helpers:Resource Key=Tab_IgnoreApplication, DefaultValue=Ignore this application (from any IP address)}"
                          Command="{Binding PlacementTarget.Tag.IgnoreApplicationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="{helpers:Resource Key=Tab_IgnoreSender, DefaultValue=Ignore this IP address}"
                          Command="{Binding PlacementTarget.Tag.IgnoreSenderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
            </ContextMenu>
            <DataTemplate x:Key="TabControlContentTemplate" DataType="models:LogTabViewModel">
              <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Shown while the tab has the filters that an earlier tab of the application had -->
                <Border Background="{DynamicResource ThemeSurfaceAlt}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="0,0,0,1" Padding="10,4"
                        Visibility="{Binding FiltersTakenOver, Converter={StaticResource ThemeBoolToVisibility}}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Padding="8,2" Margin="12,0,0,0"
                                Content="{helpers:Resource Key=Tab_RemoveFilters, DefaultValue=Remove filters}"
                                Command="{Binding DataContext.RemoveTakenOverFiltersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" TextTrimming="CharacterEllipsis"
                                   Text="{helpers:Resource Key=Tab_FiltersTakenOver, DefaultValue=The filters of the previous tab of this application were taken over.}"/>
                    </DockPanel>
                </Border>
                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                <dj:LogViewer 
                    Grid.Row="1"
                    x:Name="LogViewer1"
                    Tag="{Binding ElementName=LogViewer1}"
                    DefaultTimeStampFormat="{Binding DataContext.DefaultTimeStampFormat, RelativeSource={RelativeSource AncestorType=Window}}"
                    ListFontFamily="{Binding DataContext.ListFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                    ListFontSize="{Binding DataContext.ListFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    TraceBackground="{DynamicResource LogTraceBackground}"
                    TraceForeground="{DynamicResource LogTraceForeground}"
                    DebugBackground="{DynamicResource LogDebugBackground}"
                    DebugForeground="{DynamicResource LogDebugForeground}"
                    InfoBackground="{DynamicResource LogInfoBackground}"
                    InfoForeground="{DynamicResource LogInfoForeground}"
                    WarnBackground="{DynamicResource LogWarnBackground}"
                    WarnForeground="{DynamicResource LogWarnForeground}"
                    ErrorBackground="{DynamicResource LogErrorBackground}"
                    ErrorForeground="{DynamicResource LogErrorForeground}"
                    FatalBackground="{DynamicResource LogFatalBackground}"
                    FatalForeground="{DynamicResource LogFatalForeground}"
                    TextSearchTermBackground="{DynamicResource LogTextSearchTermBackground}"
                    TextSearchTermBorderBrush="{DynamicResource LogTextSearchTermBorderBrush}"
                    TextSearchTermForeground="{DynamicResource LogTextSearchTermForeground}"
                    RegexSearchTermBackground="{DynamicResource LogRegexSearchTermBackground}"
                    RegexSearchTermBorderBrush="{DynamicResource LogRegexSearchTermBorderBrush}"
                    RegexSearchTermForeground="{DynamicResource LogRegexSearchTermForeground}"
                    RegexPrefixForeground="{DynamicResource LogRegexPrefixForeground}"
                    SearchHighlightBackground="{DynamicResource LogSearchHighlightBackground}"
                    FindHighlightBackground="{DynamicResource LogFindHighlightBackground}"
                    ItemsSource="{Binding DataContext.LogEntries, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                    FilterState="{Binding DataContext.FilterState, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    IsLoggerTreeOnLeft="{Binding DataContext.LoggerTreeOnLeft, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    IsLoggerTreeExpanded="{Binding DataContext.LoggerTreeOpen, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    LoggerTreeWidth="{Binding DataContext.LoggerTreeWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    VisibleEntryCount="{Binding DataContext.VisibleEntryCount, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWayToSource}"
                    SearchFields="{Binding DataContext.SearchFields, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    ColumnKeys="{Binding DataContext.ColumnKeys, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    MaxCount="{Binding DataContext.MaxCount, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                    <dj:LogViewer.Resources>
                        <!-- The buttons of the control have a fixed size, so they get less padding than the buttons of the dialogs -->
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Padding" Value="2,2"/>
                        </Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <Setter Property="Padding" Value="1,2"/>
                        </Style>
                    </dj:LogViewer.Resources>
                    <dj:LogViewer.IdResolver>
                        <helpers:FileLineIdResolver />
                    </dj:LogViewer.IdResolver>
                </dj:LogViewer>
              </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
        <!-- Menu Bar -->
        <Menu x:Name="MainMenu">
            <MenuItem Header="{helpers:Resource Key=Menu_File, DefaultValue=_File}">
                <MenuItem Header="{helpers:Resource Key=Menu_OpenFile, DefaultValue=_Open File...}" 
                          Command="{Binding OpenFileCommand}" 
                          InputGestureText="Ctrl+O"/>
                <MenuItem Header="{helpers:Resource Key=Menu_OpenFileWithMapping, DefaultValue=Open File with Column _Mapping...}"
                          Command="{Binding OpenFileWithMappingCommand}"/>
                <Separator />
                <MenuItem Header="{helpers:Resource Key=Menu_Exit, DefaultValue=E_xit}" 
                          Command="{Binding ExitCommand}" 
                          InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="{helpers:Resource Key=Menu_View, DefaultValue=_View}">
                <MenuItem Header="{helpers:Resource Key=Menu_Settings, DefaultValue=_Settings...}" 
                          Command="{Binding OpenSettingsCommand}" 
                          InputGestureText="Ctrl+,"/>
            </MenuItem>
            <MenuItem Header="{helpers:Resource Key=Menu_Filter, DefaultValue=_Filter}">
                <MenuItem Header="{helpers:Resource Key=Menu_FilterApplyPreset, DefaultValue=_Apply preset}"
                          IsEnabled="{Binding HasFilterPresets}"
                          ItemsSource="{Binding FilterPresets}"
                          Tag="{Binding}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="Command" Value="{Binding Tag.ApplyFilterPresetCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="{helpers:Resource Key=Menu_FilterSavePreset, DefaultValue=_Save current filter as preset...}"
                          Command="{Binding SaveFilterPresetCommand}"/>
                <Separator />
                <MenuItem Header="{helpers:Resource Key=Menu_FilterManagePresets, DefaultValue=_Manage presets...}"
                          Command="{Binding ManageFilterPresetsCommand}"/>
            </MenuItem>
            <MenuItem Header="{helpers:Resource Key=Menu_Logs, DefaultValue=_Logs}">
                <MenuItem Header="{helpers:Resource Key=Menu_StartReceiving, DefaultValue=_Start receiving}"
                          Command="{Binding StartListeningCommand}"/>
                <MenuItem Header="{helpers:Resource Key=Menu_StopReceiving, DefaultValue=S_top receiving}"
                          Command="{Binding StopListeningCommand}"/>
                <Separator />
                <MenuItem Header="{helpers:Resource Key=Menu_Logs_Tabs, DefaultValue=_Tabs}">
                    <MenuItem Header="{helpers:Resource Key=Menu_CloseCurrentTab, DefaultValue=Close _current tab}"
                              Command="{Binding CloseCurrentTabCommand}"
                              InputGestureText="Ctrl+W"/>
                    <MenuItem Header="{helpers:Resource Key=Menu_CloseAllTabs, DefaultValue=Close _all tabs}"
                              Command="{Binding CloseAllTabsCommand}"/>
                </MenuItem>
                <MenuItem Header="{helpers:Resource Key=Menu_Export, DefaultValue=_Export}">
                    <MenuItem Header="{helpers:Resource Key=Menu_ExportLogFormat, DefaultValue=*.log format}" 
                              Command="{Binding ExportLogsCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{helpers:Resource Key=Menu_Help, DefaultValue=_Help}">
                <MenuItem Header="{helpers:Resource Key=Menu_About, DefaultValue=_About...}" 
                          Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>
        
        </StackPanel>
        
        <!-- Main Content: TabControl with LogViewers -->
        <TabControl x:Name="LogTabsControl"
                    Grid.Row="1"
                    ItemsSource="{Binding LogTabs}"
                    SelectedItem="{Binding SelectedTab}"
                    AllowDrop="True"
                    PreviewDragOver="LogTabsArea_PreviewDragOver"
                    Drop="LogTabsArea_Drop"
                    attachedProperties:TabContent.IsCached="True"
                    attachedProperties:TabContent.Template="{StaticResource TabControlContentTemplate}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="AllowDrop" Value="True"/>
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                    <Setter Property="ContextMenu" Value="{StaticResource TabContextMenu}"/>
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="LogTabItem_PreviewMouseLeftButtonDown"/>
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="LogTabItem_PreviewMouseLeftButtonUp"/>
                    <EventSetter Event="PreviewMouseUp" Handler="LogTabItem_PreviewMouseUp"/>
                    <EventSetter Event="PreviewMouseMove" Handler="LogTabItem_PreviewMouseMove"/>
                    <EventSetter Event="PreviewDragOver" Handler="LogTabItem_PreviewDragOver"/>
                    <EventSetter Event="Drop" Handler="LogTabItem_Drop"/>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Height="14" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                Background="{Binding AccentBrush}"
                                Visibility="{Binding IsLive, Converter={StaticResource ThemeBoolToVisibility}}"/>
                        <TextBlock Text="{Binding Header}" />
                        <TextBlock Text=" (" 
                                   Margin="2,0,0,0"/>
                        <TextBlock Text="{Binding LogCount}" 
                                   FontWeight="Bold"/>
                        <TextBlock Text=")" />
                        <Button Style="{StaticResource TabMenuButtonStyle}" Click="TabMenuButton_Click"
                                ToolTip="{helpers:Resource Key=Tab_Menu, DefaultValue=Tab menu}"/>
                        <Button Style="{StaticResource TabCloseButtonStyle}"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{helpers:Resource Key=Tab_Close, DefaultValue=Close tab}"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
        
        <!-- Status Bar -->
        <!-- Sources panel: grows from the status bar and pushes the list up -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}"
                BorderThickness="0,1,0,0" Padding="14,8,14,10"
                Visibility="{Binding IsSourcesPanelOpen, Converter={StaticResource ThemeBoolToVisibility}}">
            <StackPanel Grid.IsSharedSizeScope="True">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{helpers:Resource Key=Sources_Title, DefaultValue=Sources}" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Hyperlink Command="{Binding ManageSourcesCommand}">
                            <Run Text="{helpers:Resource Key=Sources_Manage, DefaultValue=Manage sources...}"/>
                        </Hyperlink>
                    </TextBlock>
                </DockPanel>
                <Grid Margin="0,0,0,4" TextElement.Foreground="{DynamicResource ThemeTextMuted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrcName" MinWidth="110"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrcKind" MinWidth="60"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrcState" MinWidth="220"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrcCount" MinWidth="90"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrcLast" MinWidth="120"/>
                            <ColumnDefinition Width="*" SharedSizeGroup="SrcOn" MinWidth="190"/>
                        </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{helpers:Resource Key=Sources_ColumnSource, DefaultValue=Source}"/>
                    <TextBlock Grid.Column="1" Text="{helpers:Resource Key=Sources_ColumnKind, DefaultValue=Kind}"/>
                    <TextBlock Grid.Column="2" Text="{helpers:Resource Key=Sources_ColumnState, DefaultValue=State}"/>
                    <TextBlock Grid.Column="3" Text="{helpers:Resource Key=Sources_ColumnEntries, DefaultValue=Entries}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="4" Text="{helpers:Resource Key=Sources_ColumnLastEntry, DefaultValue=Last entry}"/>
                    <TextBlock Grid.Column="5" Text="{helpers:Resource Key=Sources_ColumnOn, DefaultValue=On}" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ReceiveSourceViewModel}">
                            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrcName" MinWidth="110"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrcKind" MinWidth="60"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrcState" MinWidth="220"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrcCount" MinWidth="90"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SrcLast" MinWidth="120"/>
                            <ColumnDefinition Width="*" SharedSizeGroup="SrcOn" MinWidth="190"/>
                        </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource ThemeTextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Listening">
                                                <Setter Property="Fill" Value="{DynamicResource ThemeSuccess}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter Property="Fill" Value="{DynamicResource ThemeError}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                                        <TextBlock Text="{Binding StateText}" ToolTip="{Binding ErrorDetail}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding EntryCountText}" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding LastEntryText}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Visibility="{Binding CanRetry, Converter={StaticResource ThemeBoolToVisibility}}">
                                            <Hyperlink Command="{Binding RetryCommand}">
                                                <Run Text="{helpers:Resource Key=Source_Retry, DefaultValue=Try again}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                        <ToggleButton Style="{StaticResource SettingsToggleSwitch}" IsChecked="{Binding IsOn}"
                                                      AutomationProperties.Name="{Binding Name}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StatusBar Grid.Row="3">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <!-- Receiving: the state opens the sources panel, the button starts or stops all sources -->
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ThemeIconButton}" Padding="8,2" Margin="0,0,4,0"
                            FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12"
                            Foreground="{DynamicResource ThemeTextPrimary}"
                            Command="{Binding ToggleSourcesPanelCommand}"
                            ToolTip="{helpers:Resource Key=Receive_ToolTip, DefaultValue=Show the sources that receive logs}">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.Sources, RelativeSource={RelativeSource Self}}" Placement="Top">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Name}"/>
                                        <Setter Property="IsCheckable" Value="True"/>
                                        <Setter Property="IsChecked" Value="{Binding IsOn, Mode=TwoWay}"/>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource ThemeIconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextSecondary}"/>
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource ThemeTextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReceiveStatus}" Value="Active">
                                                <Setter Property="Fill" Value="{DynamicResource ThemeSuccess}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ReceiveStatus}" Value="Partial">
                                                <Setter Property="Fill" Value="{DynamicResource ThemeWarningText}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ReceiveStatus}" Value="Failed">
                                                <Setter Property="Fill" Value="{DynamicResource ThemeError}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ReceiveStatusText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ThemeIconButton}" Width="26" Height="24" Padding="0"
                            Command="{Binding ToggleReceivingCommand}"
                            AutomationProperties.Name="{helpers:Resource Key=Receive_ToggleToolTip, DefaultValue=Start or stop receiving on all sources}"
                            ToolTip="{helpers:Resource Key=Receive_ToggleToolTip, DefaultValue=Start or stop receiving on all sources}">
                        <TextBlock FontFamily="{DynamicResource ThemeIconFont}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                            <Setter Property="Text" Value="&#xE769;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </StatusBarItem>
            <!-- The selected tab: entries and what filters them -->
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TabSummary}" VerticalAlignment="Center"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding HasActiveFilter, Converter={StaticResource ThemeBoolToVisibility}}">
                        <Hyperlink Command="{Binding ResetFilterCommand}">
                            <Run Text="{helpers:Resource Key=Summary_Reset, DefaultValue=Reset filter}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
            <!-- Timestamp and language (Right) -->
            <StatusBarItem Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <!-- Zoomed with Ctrl+wheel: offers to keep the size -->
                    <TextBlock VerticalAlignment="Center" Margin="0,0,14,0"
                               Visibility="{Binding IsFontZoomed, Converter={StaticResource ThemeBoolToVisibility}}">
                        <Run Text="{Binding FontZoomText, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Hyperlink Command="{Binding SaveFontZoomCommand}">
                            <Run Text="{helpers:Resource Key=Zoom_Save, DefaultValue=Save as default}"/>
                        </Hyperlink>
                        <Run Text="  "/>
                        <Hyperlink Command="{Binding ResetFontZoomCommand}">
                            <Run Text="{helpers:Resource Key=Zoom_Reset, DefaultValue=Reset}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateNotice}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{helpers:Resource Key=About_Skip, DefaultValue=Skip this version}"
                                          Command="{Binding PlacementTarget.DataContext.SkipUpdateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                        <Hyperlink Command="{Binding AboutCommand}">
                            <Run Text="{Binding UpdateNotice, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding LastLogTimestamp}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="LanguageButton" Style="{StaticResource ThemeIconButton}"
                            Padding="5,2"
                            Cursor="Hand"
                            ToolTip="{helpers:Resource Key=Main_ChangeLanguage, DefaultValue=Change language}"
                            Click="LanguageButton_Click">
                        <Button.Content>
                            <Image Source="{Binding CurrentLanguageFlag, Converter={StaticResource SvgImageSourceConverter}}"
                                   Width="20"
                                   Height="15"
                                   Stretch="Uniform"/>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
        
        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="4" d:Visibility="Collapsed">
            <Grid Background="#80000000" 
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                  Panel.ZIndex="1000">
                <Border Background="{DynamicResource ThemeSurface}" 
                        CornerRadius="10" 
                        Padding="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="300">
                    <StackPanel>
                        <TextBlock Text="{helpers:Resource Key=Import_LoadingFile, DefaultValue=Loading file...}" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>
                        <ProgressBar IsIndeterminate="True" 
                                     Height="20" 
                                     Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding LoadingProgress}" 
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Hints and errors: a card that springs in at the bottom right, above the status bar -->
        <Border Grid.Row="0" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,44"
                Panel.ZIndex="900" CornerRadius="8" BorderThickness="1" Padding="14,9" RenderTransformOrigin="1,1"
                DataContext="{Binding Snackbar}" d:Visibility="Collapsed">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeError}"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOpen}" Value="True"/>
                                <Condition Binding="{Binding AnimationsEnabled}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="IsHitTestVisible" Value="True"/>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         From="0.85" To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         From="0.85" To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         From="10" To="0" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOpen}" Value="True"/>
                                <Condition Binding="{Binding AnimationsEnabled}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="IsHitTestVisible" Value="True"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{DynamicResource ThemeIconFont}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE73E;"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeSuccess}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Text" Value="&#xE7BA;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeError}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="420" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding HasUndo, Converter={StaticResource ThemeBoolToVisibility}}">
                    <Hyperlink Command="{Binding UndoCommand}">
                        <Run Text="{Binding UndoText, Mode=OneWay}"/>
                    </Hyperlink>
                </TextBlock>
                <Button Style="{StaticResource ThemeIconButton}" Content="&#xE711;" Width="24" Height="24" Margin="12,0,-6,0" FontSize="11"
                        Command="{Binding CloseCommand}" VerticalAlignment="Center"
                        ToolTip="{helpers:Resource Key=Snackbar_Close, DefaultValue=Close}"
                        AutomationProperties.Name="{helpers:Resource Key=Snackbar_Close, DefaultValue=Close}"
                        Visibility="{Binding IsError, Converter={StaticResource ThemeBoolToVisibility}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

