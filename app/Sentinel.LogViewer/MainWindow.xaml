<Window x:Class="Sentinel.LogViewer.MainWindow"
        Background="{DynamicResource ThemePageBackground}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dj="clr-namespace:Sentinel.LogViewer.Wpf;assembly=Sentinel.LogViewer.Wpf"
        xmlns:viewModels="clr-namespace:Sentinel.LogViewer.ViewModels"
        xmlns:helpers="clr-namespace:Sentinel.LogViewer.Helpers"
        xmlns:models="clr-namespace:Sentinel.LogViewer.Models"
        xmlns:attachedProperties="clr-namespace:Sentinel.LogViewer.AttachedProperties"
        mc:Ignorable="d" 
        Title="Sentinel LogViewer" 
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}">
    <Grid>
        <Grid.Resources>
            <!-- Small close button in the tab header; only highlighted on hover -->
            <Style x:Key="TabCloseButtonStyle" TargetType="Button">
                <Setter Property="Content" Value="✕"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Margin" Value="6,0,-2,0"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Arrow in the tab header that opens the menu of the tab -->
            <Style x:Key="TabMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource TabCloseButtonStyle}">
                <Setter Property="Content" Value="▾"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
            <!-- Tab context menu; the TabItem's Tag holds the MainViewModel -->
            <ContextMenu x:Key="TabContextMenu" x:Shared="False">
                <MenuItem Header="{helpers:Resource Key=Tab_Close, DefaultValue=Close tab}"
                          Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="{helpers:Resource Key=Tab_CloseOthers, DefaultValue=Close all other tabs}"
                          Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="{helpers:Resource Key=Tab_SaveFilteredList, DefaultValue=Save filtered list...}"
                          Command="{Binding PlacementTarget.Tag.SaveFilteredListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="{helpers:Resource Key=Tab_TakeOverFilters, DefaultValue=Take over the filters into new tabs of this application}"
                          IsChecked="{Binding TakesOverFilters, Mode=OneWay}"
                          Command="{Binding PlacementTarget.Tag.ToggleTakeOverFiltersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="{helpers:Resource Key=Tab_AfterRestart, DefaultValue=After a restart of this application}"
                          IsEnabled="{Binding IsLive}">
                    <MenuItem Header="{helpers:Resource Key=Restart_Extend, DefaultValue=Continue in the existing tab}"
                              Tag="ExtendTab" IsChecked="{Binding RestartExtendsTab, Mode=OneWay}" Click="RestartBehaviorMenuItem_Click"/>
                    <MenuItem Header="{helpers:Resource Key=Restart_NewTab, DefaultValue=Open a new tab}"
                              Tag="NewTab" IsChecked="{Binding RestartsInNewTab, Mode=OneWay}" Click="RestartBehaviorMenuItem_Click"/>
                    <MenuItem Header="{helpers:Resource Key=Restart_Replace, DefaultValue=Open a new tab and close the old one}"
                              Tag="ReplaceTab" IsChecked="{Binding RestartReplacesTab, Mode=OneWay}" Click="RestartBehaviorMenuItem_Click"/>
                </MenuItem>
            </ContextMenu>
            <DataTemplate x:Key="TabControlContentTemplate" DataType="models:LogTabViewModel">
              <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Shown while the tab has the filters that an earlier tab of the application had -->
                <Border Background="{DynamicResource ThemeSurfaceAlt}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="0,0,0,1" Padding="10,4"
                        Visibility="{Binding FiltersTakenOver, Converter={StaticResource ThemeBoolToVisibility}}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Padding="8,2" Margin="12,0,0,0"
                                Content="{helpers:Resource Key=Tab_RemoveFilters, DefaultValue=Remove filters}"
                                Command="{Binding DataContext.RemoveTakenOverFiltersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" TextTrimming="CharacterEllipsis"
                                   Text="{helpers:Resource Key=Tab_FiltersTakenOver, DefaultValue=The filters of the previous tab of this application were taken over.}"/>
                    </DockPanel>
                </Border>
                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                <dj:LogViewer 
                    Grid.Row="1"
                    x:Name="LogViewer1"
                    Tag="{Binding ElementName=LogViewer1}"
                    DefaultTimeStampFormat="{Binding DataContext.DefaultTimeStampFormat, RelativeSource={RelativeSource AncestorType=Window}}"
                    TraceBackground="{DynamicResource LogTraceBackground}"
                    TraceForeground="{DynamicResource LogTraceForeground}"
                    DebugBackground="{DynamicResource LogDebugBackground}"
                    DebugForeground="{DynamicResource LogDebugForeground}"
                    InfoBackground="{DynamicResource LogInfoBackground}"
                    InfoForeground="{DynamicResource LogInfoForeground}"
                    WarnBackground="{DynamicResource LogWarnBackground}"
                    WarnForeground="{DynamicResource LogWarnForeground}"
                    ErrorBackground="{DynamicResource LogErrorBackground}"
                    ErrorForeground="{DynamicResource LogErrorForeground}"
                    FatalBackground="{DynamicResource LogFatalBackground}"
                    FatalForeground="{DynamicResource LogFatalForeground}"
                    TextSearchTermBackground="{DynamicResource LogTextSearchTermBackground}"
                    TextSearchTermBorderBrush="{DynamicResource LogTextSearchTermBorderBrush}"
                    TextSearchTermForeground="{DynamicResource LogTextSearchTermForeground}"
                    RegexSearchTermBackground="{DynamicResource LogRegexSearchTermBackground}"
                    RegexSearchTermBorderBrush="{DynamicResource LogRegexSearchTermBorderBrush}"
                    RegexSearchTermForeground="{DynamicResource LogRegexSearchTermForeground}"
                    RegexPrefixForeground="{DynamicResource LogRegexPrefixForeground}"
                    SearchHighlightBackground="{DynamicResource LogSearchHighlightBackground}"
                    FindHighlightBackground="{DynamicResource LogFindHighlightBackground}"
                    ItemsSource="{Binding DataContext.LogEntries, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                    FilterState="{Binding DataContext.FilterState, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    IsLoggerTreeOnLeft="{Binding DataContext.LoggerTreeOnLeft, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    IsLoggerTreeExpanded="{Binding DataContext.LoggerTreeOpen, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    LoggerTreeWidth="{Binding DataContext.LoggerTreeWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    SearchFields="{Binding DataContext.SearchFields, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=TwoWay}"
                    MaxCount="{Binding DataContext.MaxCount, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                    <dj:LogViewer.Resources>
                        <!-- The buttons of the control have a fixed size, so they get less padding than the buttons of the dialogs -->
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Padding" Value="2,2"/>
                        </Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <Setter Property="Padding" Value="1,2"/>
                        </Style>
                    </dj:LogViewer.Resources>
                    <dj:LogViewer.IdResolver>
                        <helpers:FileLineIdResolver />
                    </dj:LogViewer.IdResolver>
                </dj:LogViewer>
              </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
        <!-- Menu Bar -->
        <Menu x:Name="MainMenu">
            <MenuItem Header="{helpers:Resource Key=Menu_File, DefaultValue=_File}">
                <MenuItem Header="{helpers:Resource Key=Menu_OpenFile, DefaultValue=_Open File...}" 
                          Command="{Binding OpenFileCommand}" 
                          InputGestureText="Ctrl+O"/>
                <MenuItem Header="{helpers:Resource Key=Menu_OpenFileWithMapping, DefaultValue=Open File with Column _Mapping...}"
                          Command="{Binding OpenFileWithMappingCommand}"/>
                <Separator />
                <MenuItem Header="{helpers:Resource Key=Menu_Exit, DefaultValue=E_xit}" 
                          Command="{Binding ExitCommand}" 
                          InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="{helpers:Resource Key=Menu_View, DefaultValue=_View}">
                <MenuItem Header="{helpers:Resource Key=Menu_Settings, DefaultValue=_Settings...}" 
                          Command="{Binding OpenSettingsCommand}" 
                          InputGestureText="Ctrl+,"/>
            </MenuItem>
            <MenuItem Header="{helpers:Resource Key=Menu_Logs, DefaultValue=_Logs}">
                <MenuItem Header="{helpers:Resource Key=Menu_Logs_Tabs, DefaultValue=_Tabs}">
                    <MenuItem Header="{helpers:Resource Key=Menu_CloseCurrentTab, DefaultValue=Close _current tab}"
                              Command="{Binding CloseCurrentTabCommand}"/>
                    <MenuItem Header="{helpers:Resource Key=Menu_CloseAllTabs, DefaultValue=Close _all tabs}"
                              Command="{Binding CloseAllTabsCommand}"/>
                </MenuItem>
                <MenuItem Header="{helpers:Resource Key=Menu_Export, DefaultValue=_Export}">
                    <MenuItem Header="{helpers:Resource Key=Menu_ExportLogFormat, DefaultValue=*.log format}" 
                              Command="{Binding ExportLogsCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{helpers:Resource Key=Menu_Help, DefaultValue=_Help}">
                <MenuItem Header="{helpers:Resource Key=Menu_About, DefaultValue=_About...}" 
                          Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>
        
        <!-- Toolbar -->
        <ToolBar>
            <Button Content="{helpers:Resource Key=Button_StartListening, DefaultValue=Start Listening}" 
                    Command="{Binding StartListeningCommand}" 
                    ToolTip="{helpers:Resource Key=ToolTip_StartListening, DefaultValue=Start listening on configured ports}"/>
            <Button Content="{helpers:Resource Key=Button_StopListening, DefaultValue=Stop Listening}" 
                    Command="{Binding StopListeningCommand}" 
                    ToolTip="{helpers:Resource Key=ToolTip_StopListening, DefaultValue=Stop listening on all ports}"/>
            <Separator />
            <TextBlock Text="{helpers:Resource Key=Status_Label, DefaultValue=Status:}" VerticalAlignment="Center" Margin="5,0"/>
            <Border Background="{DynamicResource ThemeHover}" CornerRadius="10" Padding="9,2" Margin="5,0"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding ListeningStatus}" FontWeight="SemiBold"/>
            </Border>
        </ToolBar>
        </StackPanel>
        
        <!-- Main Content: TabControl with LogViewers -->
        <TabControl x:Name="LogTabsControl"
                    Grid.Row="1"
                    ItemsSource="{Binding LogTabs}"
                    SelectedItem="{Binding SelectedTab}"
                    AllowDrop="True"
                    PreviewDragOver="LogTabsArea_PreviewDragOver"
                    Drop="LogTabsArea_Drop"
                    attachedProperties:TabContent.IsCached="True"
                    attachedProperties:TabContent.Template="{StaticResource TabControlContentTemplate}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="AllowDrop" Value="True"/>
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                    <Setter Property="ContextMenu" Value="{StaticResource TabContextMenu}"/>
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="LogTabItem_PreviewMouseLeftButtonDown"/>
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="LogTabItem_PreviewMouseLeftButtonUp"/>
                    <EventSetter Event="PreviewMouseMove" Handler="LogTabItem_PreviewMouseMove"/>
                    <EventSetter Event="PreviewDragOver" Handler="LogTabItem_PreviewDragOver"/>
                    <EventSetter Event="Drop" Handler="LogTabItem_Drop"/>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header}" />
                        <TextBlock Text=" (" 
                                   Margin="2,0,0,0"/>
                        <TextBlock Text="{Binding LogCount}" 
                                   FontWeight="Bold"/>
                        <TextBlock Text=")" />
                        <Button Style="{StaticResource TabMenuButtonStyle}" Click="TabMenuButton_Click"
                                ToolTip="{helpers:Resource Key=Tab_Menu, DefaultValue=Tab menu}"/>
                        <Button Style="{StaticResource TabCloseButtonStyle}"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{helpers:Resource Key=Tab_Close, DefaultValue=Close tab}"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <!-- Language Selector (Left) -->
            <StatusBarItem HorizontalAlignment="Left">
                <Button x:Name="LanguageButton" Style="{StaticResource ThemeIconButton}" 
                        Padding="5,2"
                        Cursor="Hand"
                        ToolTip="Change Language"
                        Click="LanguageButton_Click">
                    <Button.Content>
                        <Image Source="{Binding CurrentLanguageFlag, Converter={StaticResource SvgImageSourceConverter}}" 
                               Width="20" 
                               Height="15" 
                               Stretch="Uniform"/>
                    </Button.Content>
                </Button>
            </StatusBarItem>
            <Separator />
            <!-- Status Message (Center) -->
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <!-- Update notice -->
            <StatusBarItem>
                <StatusBarItem.Style>
                    <Style TargetType="StatusBarItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateNotice}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StatusBarItem.Style>
                <TextBlock>
                    <Hyperlink Command="{Binding AboutCommand}">
                        <Run Text="{Binding UpdateNotice, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </StatusBarItem>
            <!-- Timestamp (Right) -->
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding LastLogTimestamp}" />
            </StatusBarItem>
        </StatusBar>
        
        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3" d:Visibility="Collapsed">
            <Grid Background="#80000000" 
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                  Panel.ZIndex="1000">
                <Border Background="{DynamicResource ThemeSurface}" 
                        CornerRadius="10" 
                        Padding="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="300">
                    <StackPanel>
                        <TextBlock Text="Loading File..." 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>
                        <ProgressBar IsIndeterminate="True" 
                                     Height="20" 
                                     Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding LoadingProgress}" 
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

