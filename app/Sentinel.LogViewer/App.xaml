<Application x:Class="Sentinel.LogViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xamlConverter="clr-namespace:Sentinel.LogViewer.Wpf.XamlConverter;assembly=Sentinel.LogViewer.Wpf"
             xmlns:xamlMultiValueConverter="clr-namespace:Sentinel.LogViewer.Wpf.XamlMultiValueConverter;assembly=Sentinel.LogViewer.Wpf"
             xmlns:converters="clr-namespace:Sentinel.LogViewer.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- LogViewer Design Styles -->
                <ResourceDictionary Source="pack://application:,,,/Sentinel.LogViewer.Wpf;component/Themes/Generic.xaml"/>
                <!-- The colours of the default theme. ThemeService replaces them with the theme in use; here they let the designer show the windows. -->
                <ResourceDictionary Source="Styles/Themes/NewschoolLight.xaml"/>
                <!-- Look of the application: the styles that use the colours -->
                <ResourceDictionary Source="Styles/Theme.xaml"/>
                <ResourceDictionary Source="Styles/AppStyles.xaml"/>
                <ResourceDictionary Source="Styles/ShellStyles.xaml"/>
                <ResourceDictionary Source="Styles/ControlStyles.xaml"/>
                <ResourceDictionary Source="Styles/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters -->
            <xamlConverter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <xamlMultiValueConverter:ILogEntryResolverToStringConverter x:Key="ILogEntryResolverToStringConverter"/>
            <converters:SvgImageSourceConverter x:Key="SvgImageSourceConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

