<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Sentinel.LogViewer.Controls"
                    xmlns:helpers="clr-namespace:Sentinel.LogViewer.Helpers">

    <!-- Styles of the settings window; the colours come from Theme.xaml -->

    <!-- Card for one setting -->
    <Style TargetType="controls:SettingCard">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingCard">
                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Setting.Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{DynamicResource ThemeIconFont}" FontSize="18"
                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Setting.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Setting.Description, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Foreground="{DynamicResource ThemeTextSecondary}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <ContentPresenter Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0"
                                              Content="{TemplateBinding Details}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On / off switch -->
    <Style x:Key="SettingsToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10" Background="Transparent"
                                BorderBrush="{DynamicResource ThemeTextSecondary}" BorderThickness="1"/>
                        <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource ThemeTextSecondary}"
                                 HorizontalAlignment="Left" Margin="4,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ThemeOnAccent}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsErrorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeError}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Search box with magnifier, placeholder (Tag) and clear button -->
    <Style x:Key="SettingsSearchBox" TargetType="TextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{DynamicResource ThemeSurface}"
                            BorderBrush="{DynamicResource ThemeBorderStrong}"
                            BorderThickness="1" CornerRadius="6" Padding="10,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource ThemeIconFont}" FontSize="13"
                                       Foreground="{DynamicResource ThemeTextMuted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Grid Grid.Column="1">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0,6"/>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" IsHitTestVisible="False"
                                           Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                            <Button x:Name="Clear" Grid.Column="2" Content="&#xE711;"
                                    Command="{Binding DataContext.ClearSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{DynamicResource ThemeIconButton}" Width="26" Height="26" FontSize="10"
                                    Focusable="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Clear" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Entry of the navigation list -->
    <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="10,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button at the bottom of the navigation -->
    <Style x:Key="SettingsNavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="10,7">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
