<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- The colours of the theme "Warm". Every theme defines the same keys, see ThemeCatalog.Tokens; a theme is swapped in by ThemeService. -->

    <!-- Font: the font of Windows 11 where there is one, Segoe UI elsewhere -->
    <FontFamily x:Key="ThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Interface -->
    <SolidColorBrush x:Key="ThemePageBackground" po:Freeze="True" Color="#F5F4ED"/>
    <SolidColorBrush x:Key="ThemeSurface" po:Freeze="True" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeSurfaceAlt" po:Freeze="True" Color="#EFEDE4"/>
    <SolidColorBrush x:Key="ThemeBorder" po:Freeze="True" Color="#E0DDD2"/>
    <SolidColorBrush x:Key="ThemeBorderStrong" po:Freeze="True" Color="#8E8A7D"/>
    <SolidColorBrush x:Key="ThemeTextPrimary" po:Freeze="True" Color="#1F1E1D"/>
    <SolidColorBrush x:Key="ThemeTextSecondary" po:Freeze="True" Color="#4A4944"/>
    <SolidColorBrush x:Key="ThemeTextMuted" po:Freeze="True" Color="#6B685F"/>
    <SolidColorBrush x:Key="ThemeAccent" po:Freeze="True" Color="#2A67A8"/>
    <SolidColorBrush x:Key="ThemeAccentSoft" po:Freeze="True" Color="#E3EDF8"/>
    <SolidColorBrush x:Key="ThemeOnAccent" po:Freeze="True" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHover" po:Freeze="True" Color="#EAE8DF"/>
    <SolidColorBrush x:Key="ThemeSuccess" po:Freeze="True" Color="#3B6D11"/>
    <SolidColorBrush x:Key="ThemeError" po:Freeze="True" Color="#A32D2D"/>
    <SolidColorBrush x:Key="ThemeWarningBackground" po:Freeze="True" Color="#FAEEDA"/>
    <SolidColorBrush x:Key="ThemeWarningText" po:Freeze="True" Color="#633806"/>

    <!-- LogLevels -->
    <SolidColorBrush x:Key="LogTraceBackground" po:Freeze="True" Color="#F1EFE8"/>
    <SolidColorBrush x:Key="LogTraceForeground" po:Freeze="True" Color="#5F5E5A"/>
    <SolidColorBrush x:Key="LogDebugBackground" po:Freeze="True" Color="#EAF3DE"/>
    <SolidColorBrush x:Key="LogDebugForeground" po:Freeze="True" Color="#27500A"/>
    <SolidColorBrush x:Key="LogInfoBackground" po:Freeze="True" Color="#E6F1FB"/>
    <SolidColorBrush x:Key="LogInfoForeground" po:Freeze="True" Color="#0C447C"/>
    <SolidColorBrush x:Key="LogWarnBackground" po:Freeze="True" Color="#FAEEDA"/>
    <SolidColorBrush x:Key="LogWarnForeground" po:Freeze="True" Color="#633806"/>
    <SolidColorBrush x:Key="LogErrorBackground" po:Freeze="True" Color="#FCEBEB"/>
    <SolidColorBrush x:Key="LogErrorForeground" po:Freeze="True" Color="#791F1F"/>
    <SolidColorBrush x:Key="LogFatalBackground" po:Freeze="True" Color="#A32D2D"/>
    <SolidColorBrush x:Key="LogFatalForeground" po:Freeze="True" Color="#FFFFFF"/>

    <!-- Highlighting -->
    <SolidColorBrush x:Key="LogTextSearchTermBackground" po:Freeze="True" Color="#FAEEDA"/>
    <SolidColorBrush x:Key="LogTextSearchTermBorderBrush" po:Freeze="True" Color="#EF9F27"/>
    <SolidColorBrush x:Key="LogTextSearchTermForeground" po:Freeze="True" Color="#1F1E1D"/>
    <SolidColorBrush x:Key="LogRegexSearchTermBackground" po:Freeze="True" Color="#E6F1FB"/>
    <SolidColorBrush x:Key="LogRegexSearchTermBorderBrush" po:Freeze="True" Color="#85B7EB"/>
    <SolidColorBrush x:Key="LogRegexSearchTermForeground" po:Freeze="True" Color="#1F1E1D"/>
    <SolidColorBrush x:Key="LogRegexPrefixForeground" po:Freeze="True" Color="#185FA5"/>
    <SolidColorBrush x:Key="LogSearchHighlightBackground" po:Freeze="True" Color="#FAC775"/>
    <SolidColorBrush x:Key="LogFindHighlightBackground" po:Freeze="True" Color="#F4C0D1"/>
</ResourceDictionary>
