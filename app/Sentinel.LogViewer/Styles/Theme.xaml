<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The colours of the application are brushes in the application resources, named Theme* and Log*. ThemeService
        sets them from the selected theme (see ThemeCatalog). The styles refer to them with DynamicResource, so a
        change of the theme or of a colour shows in every window at once.
    -->

    <!-- Glyphs of the symbol font: Segoe MDL2 Assets -->
    <FontFamily x:Key="ThemeIconFont">Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
