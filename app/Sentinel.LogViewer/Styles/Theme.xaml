<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The colours of the application are brushes named Theme* and Log*. They are defined in the dictionaries in
        Styles/Themes, one for each theme and mode; ThemeService merges the one of the selected theme into the
        application resources, and behind it a dictionary with the custom colours of the user. The styles refer to the
        brushes with DynamicResource, so a change of the theme or of a colour shows in every window at once.
    -->

    <!-- Glyphs of the symbol font: Segoe MDL2 Assets -->
    <FontFamily x:Key="ThemeIconFont">Segoe MDL2 Assets</FontFamily>

    <!-- The font of the windows; a theme may set another one, which is merged behind this one -->
    <x:Static x:Key="ThemeFontFamily" Member="SystemFonts.MessageFontFamily"/>
</ResourceDictionary>
