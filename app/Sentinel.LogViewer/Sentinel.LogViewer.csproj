<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>Sentinel.LogViewer.App</StartupObject>
    <RootNamespace>Sentinel.LogViewer</RootNamespace>
    <AssemblyName>Sentinel.LogViewer</AssemblyName>
    <!-- Display name in Task Manager / Properties (do not change Directory.build.props Product for NuGet libs). -->
    <AssemblyTitle>Sentinel LogViewer</AssemblyTitle>
    <Product>Sentinel LogViewer</Product>
    <FileDescription>Sentinel LogViewer</FileDescription>
    <ApplicationIcon>Resources\icons\icons8-analysieren-64.ico</ApplicationIcon>
    <!-- Restore runtime packs for WiX/publish; omit single RuntimeIdentifier so plain build is RID-agnostic -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- The desktop app ships as MSI, Chocolatey package and portable ZIP, never as a NuGet package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="Resources\icons\icons8-analysieren-256.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\flags\*.svg" />
    <Resource Include="Resources\icons\icons8-analysieren-64.ico" />
    <Resource Include="Resources\icons\icons8-analysieren-64.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="NLog" Version="6.0.0" />
    <PackageReference Include="System.Reactive" Version="6.0.0" />
    <PackageReference Include="SharpVectors" Version="1.8.5" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ui\Sentinel.LogViewer.Wpf\Sentinel.LogViewer.Wpf.csproj" />
    <ProjectReference Include="..\Sentinel.LogViewer.TestLogging\Sentinel.LogViewer.TestLogging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sentinel.LogViewer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <SplashScreen Include="Resources\icons\icons8-analysieren-256.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  
</Project>
