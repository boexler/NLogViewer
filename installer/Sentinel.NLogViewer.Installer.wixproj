<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>

    <OutputType>Package</OutputType>

    <OutputName>NLogViewer</OutputName>

    <!-- Four-part version required for MSI; overridden in CI via /p:InstallerVersion= -->

    <InstallerVersion Condition="'$(InstallerVersion)' == ''">1.0.0.0</InstallerVersion>

    <DefineConstants>$(DefineConstants);InstallerVersion=$(InstallerVersion)</DefineConstants>

  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="WixToolset.Heat" Version="5.0.2" />

    <ProjectReference Include="..\app\Sentinel.NLogViewer.App\Sentinel.NLogViewer.App.csproj" Publish="true">

      <AdditionalProperties>SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true</AdditionalProperties>

    </ProjectReference>

    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />

  </ItemGroup>

  <ItemGroup>

    <Content Include="License.rtf" />

  </ItemGroup>

  <!--

    HarvestDirectory must be assigned in a Target: $(IntermediateOutputPath) is not set during early

    property evaluation, so static PublishHarvestDir would resolve to wrong folder and Heat would not

    emit HarvestedComponents (WIX0094).

  -->

  <Target Name="ResolveWixPublishHarvestDir">

    <PropertyGroup>

      <_WixHarvestPrimary>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'publish', 'Sentinel.NLogViewer.App'))))</_WixHarvestPrimary>

      <_WixHarvestObjCfg>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'obj', '$(Configuration)', 'publish', 'Sentinel.NLogViewer.App'))))</_WixHarvestObjCfg>

      <_WixHarvestObjPlatCfg>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'obj', '$(Platform)', '$(Configuration)', 'publish', 'Sentinel.NLogViewer.App'))))</_WixHarvestObjPlatCfg>

      <PublishHarvestDir>$(_WixHarvestPrimary)</PublishHarvestDir>

      <PublishHarvestDir Condition="!Exists('$(_WixHarvestPrimary)') AND Exists('$(_WixHarvestObjPlatCfg)')">$(_WixHarvestObjPlatCfg)</PublishHarvestDir>

      <PublishHarvestDir Condition="!Exists('$(PublishHarvestDir)') AND Exists('$(_WixHarvestObjCfg)')">$(_WixHarvestObjCfg)</PublishHarvestDir>

    </PropertyGroup>

    <ItemGroup>

      <HarvestDirectory Remove="@(HarvestDirectory)" />

      <HarvestDirectory Include="$(PublishHarvestDir)">

        <ComponentGroupName>HarvestedComponents</ComponentGroupName>

        <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>

        <SuppressRootDirectory>true</SuppressRootDirectory>

        <SuppressRegistry>true</SuppressRegistry>

      </HarvestDirectory>

      <BindPath Include="$(PublishHarvestDir)" />

    </ItemGroup>

    <Message Importance="low" Text="ResolveWixPublishHarvestDir: $(PublishHarvestDir)" />

  </Target>

</Project>


